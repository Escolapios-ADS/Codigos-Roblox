---
import Layout from '../../../layouts/Layout.astro';
import CodeCard from '../../../components/CodeCard.astro';
import RedeemGuide from '../../../components/RedeemGuide.astro';
import FaqSection from '../../../components/FaqSection.astro';
import AdBanner from '../../../components/AdBanner.astro';
import { gamesData } from '../../../data/games';
import { getTranslations } from '../../../i18n/translations';
import type { GameItem } from '../../../types/game';

export function getStaticPaths() {
  return gamesData.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

interface Props {
  game: GameItem;
}

const { game } = Astro.props;
const locale = 'es';
const t = getTranslations(locale);

import { buildGameSchema } from '../../../utils/structuredData';

const pageTitle = `Códigos ${game.title} (2026) | CódigosRoblox`;
const pageDescription = game.metaDescription[locale];

// Schema JSON-LD for rich snippets (VideoGame + BreadcrumbList + FAQPage + ItemList Active Codes)
const canonicalGameUrl = `https://codigosroblox.org/${locale}/juego/${game.slug}/`;
const pageSchema = {
  '@graph': buildGameSchema(game, locale, canonicalGameUrl)
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  currentSlug={game.slug}
  schema={pageSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400">
      <a href={`/${locale}/`} class="hover:text-white transition-colors">{t.gameDetail.breadcrumbsHome}</a>
      <span>/</span>
      <a href={`/${locale}/#juegos`} class="hover:text-white transition-colors">{t.gameDetail.breadcrumbsGames}</a>
      <span>/</span>
      <span class="text-indigo-400 font-semibold">{game.title}</span>
    </nav>

    <!-- Game Header Card -->
    <div class="relative overflow-hidden bg-[#0d1322] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class={`w-20 h-20 rounded-2xl bg-gradient-to-tr ${game.iconGradient} p-[2px] shadow-2xl shrink-0`}>
            <div class="w-full h-full bg-[#0b0f19] rounded-[14px] flex items-center justify-center text-4xl">
              {game.emoji}
            </div>
          </div>
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">
                {game.categoryLabel[locale]}
              </span>
              <span class="text-slate-600">•</span>
              <span class="text-xs text-slate-400 font-medium">
                Por {game.developer}
              </span>
              {game.badge && (
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-white/5 border border-white/10 text-slate-200">
                  {game.badge[locale]}
                </span>
              )}
            </div>
            <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
              Códigos de {game.title}
            </h1>
            <p class="text-xs sm:text-sm text-slate-300">
              {game.tagline[locale]}
            </p>
          </div>
        </div>

        <!-- Official Roblox link CTA -->
        <a 
          href={game.robloxUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 text-xs font-bold text-white transition-all flex items-center gap-2"
        >
          <span>{t.gameDetail.playOnRoblox}</span>
          <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Live verified bar -->
      <div class="mt-6 pt-6 border-t border-white/5 flex flex-wrap items-center justify-between gap-4 text-xs">
        <div class="flex items-center gap-2 text-emerald-400 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>{t.gameDetail.verifiedToday} (Septiembre 2026)</span>
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <span>👍 {game.likes} likes</span>
          <span>👁️ {game.visits} visitas</span>
          <span>⚡ {game.activePlayers} jugadores</span>
        </div>
      </div>
    </div>

    <!-- Top Game Leaderboard Ad Slot -->
    <AdBanner slotType="leaderboard" slotId="game-top-leaderboard" locale={locale} />

    <!-- Active Codes Section -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black text-white tracking-tight flex items-center gap-2">
            <span>{t.gameDetail.activeCodesTitle} {game.title}</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              {game.activeCodes.length} ACTIVOS
            </span>
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">
            {t.gameDetail.activeCodesSubtitle}
          </p>
        </div>

        <!-- Quick actions: Copy all & Share -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            type="button"
            onclick={`window.copyAllCodes(${JSON.stringify(game.activeCodes.map(c => c.code))}, this)`}
            class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-bold text-xs shadow-lg shadow-indigo-600/20 border border-indigo-400/30 transition-all flex items-center gap-1.5"
            title="Copiar todos los códigos activos para canjear en cadena"
          >
            <span>📋</span>
            <span>Copiar Todos ({game.activeCodes.length})</span>
          </button>
          <button
            type="button"
            onclick={`window.sharePage('${game.title} Códigos Activos 2026', window.location.href, this)`}
            class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white font-semibold text-xs border border-white/10 transition-all flex items-center gap-1"
            title="Compartir página con amigos"
          >
            <span>🔗</span>
            <span>Compartir</span>
          </button>
        </div>
      </div>

      <!-- Codes list -->
      <div class="space-y-3">
        {game.activeCodes.map((codeItem) => (
          <CodeCard codeItem={codeItem} locale={locale} />
        ))}
      </div>
    </section>

    <!-- Special Blox Fruits Trade Calculator Callout -->
    {game.slug === 'blox-fruits' && (
      <div class="relative overflow-hidden bg-gradient-to-r from-amber-950/40 via-orange-950/40 to-rose-950/40 border border-amber-500/30 rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-2xl shrink-0">
            ⚖️
          </div>
          <div>
            <h4 class="text-sm font-bold text-white flex items-center gap-2">
              <span>¿Vas a tradear frutas en el Café o la Mansión?</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/20 border border-amber-500/30 text-amber-300">W / F / L</span>
            </h4>
            <p class="text-xs text-slate-300 mt-0.5">
              Usa nuestra Calculadora de Tradeos en vivo para saber si ganas o pierdes valor y validar la regla del 40% de Beli.
            </p>
          </div>
        </div>
        <a
          href={`/${locale}/calculadora-tradeos-blox-fruits/`}
          class="shrink-0 px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-bold text-xs shadow-lg shadow-amber-600/30 border border-amber-400/40 transition-all flex items-center gap-1.5"
        >
          <span>⚖️ Abrir Calculadora</span>
          <span>→</span>
        </a>
      </div>
    )}

    <!-- Special Boombox Music Callout for Brookhaven & Da Hood -->
    {['brookhaven-rp', 'da-hood'].includes(game.slug) && (
      <div class="relative overflow-hidden bg-gradient-to-r from-purple-950/40 via-indigo-950/40 to-cyan-950/40 border border-indigo-500/30 rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-2xl shrink-0">
            📻
          </div>
          <div>
            <h4 class="text-sm font-bold text-white flex items-center gap-2">
              <span>¿Tienes la radio o Boombox de {game.title}?</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-500/20 border border-rose-500/30 text-rose-300">VIRAL</span>
            </h4>
            <p class="text-xs text-slate-300 mt-0.5">
              Explora nuestra colección exclusiva de códigos de canciones (Phonk, Pop, Anime y TikTok) listos para copiar y sonar en tu partida.
            </p>
          </div>
        </div>
        <a
          href={`/${locale}/musica/`}
          class="shrink-0 px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-bold text-xs shadow-lg shadow-indigo-600/30 border border-indigo-400/40 transition-all flex items-center gap-1.5"
        >
          <span>🎵 Ver Códigos de Música</span>
          <span>→</span>
        </a>
      </div>
    )}

    <!-- Special Free Items Callout for Promo Codes Page -->
    {game.slug === 'roblox-promo-codes' && (
      <div class="relative overflow-hidden bg-gradient-to-r from-emerald-950/40 via-teal-950/40 to-cyan-950/40 border border-emerald-500/30 rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-2xl shrink-0">
            🎁
          </div>
          <div>
            <h4 class="text-sm font-bold text-white flex items-center gap-2">
              <span>¿Quieres más ropa y accesorios gratis sin gastar Robux?</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300">0 ROBUX</span>
            </h4>
            <p class="text-xs text-slate-300 mt-0.5">
              Descubre más de 20 paquetes de personajes, peinados, alas y mochilas oficiales del Marketplace a coste cero.
            </p>
          </div>
        </div>
        <a
          href={`/${locale}/objetos-gratis/`}
          class="shrink-0 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/30 border border-emerald-400/40 transition-all flex items-center gap-1.5"
        >
          <span>🎁 Ver Objetos Gratis</span>
          <span>→</span>
        </a>
      </div>
    )}

    <!-- Mid-content Ad Placement (AdSense Compliant) -->
    <AdBanner slotType="horizontal" locale={locale} />

    <!-- Expired Codes Accordion -->
    {game.expiredCodes.length > 0 && (
      <section class="bg-[#0b101d] border border-white/10 rounded-2xl p-6">
        <details class="group [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer">
            <div>
              <h3 class="text-lg font-bold text-slate-300 group-hover:text-white transition-colors">
                {t.gameDetail.expiredCodesTitle} ({game.expiredCodes.length})
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                {t.gameDetail.expiredCodesSubtitle}
              </p>
            </div>
            <span class="text-xs text-indigo-400 group-open:rotate-180 transition-transform">
              ▼
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-white/5 space-y-2">
            {game.expiredCodes.map((item) => (
              <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.01] border border-white/5 text-xs text-slate-500">
                <span class="font-mono line-through text-slate-400">{item.code}</span>
                <span>{item.reward[locale]}</span>
              </div>
            ))}
          </div>
        </details>
      </section>
    )}

    <!-- How to Redeem Section -->
    <RedeemGuide
      title={game.howToRedeem[locale].title}
      steps={game.howToRedeem[locale].steps}
      tip={game.howToRedeem[locale].tip}
      locale={locale}
    />

    <!-- Pre-FAQ In-Content Ad -->
    <AdBanner slotType="horizontal" slotId="game-pre-faq-banner" locale={locale} />

    <!-- FAQ Section -->
    <FaqSection
      faqs={game.faqs[locale]}
      gameTitle={game.title}
      locale={locale}
    />

    <!-- Community Reporting Box -->
    <div class="bg-indigo-950/30 border border-indigo-500/20 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <h4 class="text-sm font-bold text-white">{t.gameDetail.reportBroken}</h4>
        <p class="text-xs text-slate-400">{t.gameDetail.reportBrokenText}</p>
      </div>
      <a 
        href={`/${locale}/`}
        class="shrink-0 text-xs font-semibold text-indigo-300 hover:text-white underline underline-offset-4"
      >
        ← Volver al catálogo completo
      </a>
    </div>

  </div>
</Layout>
