---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import TierListMaker from '../../components/TierListMaker.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'es';
const t = getTranslations(locale);

const pageTitle = 'Tier List Maker Blox Fruits 2026 | Crea y Descarga tu Tier List de Frutas';
const pageDescription = 'Creador interactivo de Tier List de Blox Fruits 2026. Arrastra y clasifica las mejores frutas para PvP, Farmeo y Sea Events. Descarga gratis tu imagen PNG para Discord y TikTok.';

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Blox Fruits Tier List Maker 2026',
      operatingSystem: 'All',
      applicationCategory: 'GameApplication',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
      },
      description: 'Herramienta interactiva para crear, personalizar y descargar imágenes PNG de Tier Lists de frutas de Blox Fruits en Roblox.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Cuál es la mejor fruta de Blox Fruits en 2026 para PvP?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En el meta competitivo actual de 2026, Kitsune y Portal lideran el Tier S+. Kitsune ofrece la mayor velocidad y daño masivo sin necesidad de combos complejos, mientras que Portal permite una movilidad absoluta y combos one-shot con espada en el Tercer Mar.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cuál es la mejor fruta para subir de nivel y farmear rápido?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Buddha (Buda) es la fruta reina absoluta del farmeo y eventos marinos (Sea Events). Su rango masivo de espada y reducción de daño del 50% permiten limpiar oleadas de NPCs y jefes en segundos.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Puedo descargar mi Tier List de Blox Fruits para compartirla?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí, nuestra herramienta incluye un motor de exportación en alta definición (1080p). Solo debes pulsar el botón "Descargar Imagen (PNG)" para guardarla al instante y compartirla con tus amigos en Discord, TikTok o Reddit.',
          },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://codigosroblox.org/es/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tier List Maker Blox Fruits',
          item: 'https://codigosroblox.org/es/tier-list-blox-fruits/',
        },
      ],
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <main class="min-h-screen pb-20 pt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <a href="/es/" class="hover:text-amber-400 transition-colors">Inicio</a>
        <span>/</span>
        <span class="text-slate-200">Herramientas VIP</span>
        <span>/</span>
        <span class="text-amber-400">Tier List Maker Blox Fruits</span>
      </nav>

      <!-- Hero Header -->
      <div class="relative text-center max-w-4xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Meta Update 24 & Rework Dragón 2026
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white">
          Tier List Maker <span class="bg-gradient-to-r from-amber-400 via-orange-400 to-rose-400 bg-clip-text text-transparent">Blox Fruits 2026</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Crea tu propia clasificación de Frutas del Diablo con nuestro simulador Drag & Drop. Usa plantillas de <strong>PvP</strong>, <strong>Farmeo</strong> o <strong>Tradeos</strong> y descarga tu imagen en alta resolución para presumir en Discord y redes.
        </p>

        <!-- Feature Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
          <span class="px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">
            📥 Descarga en PNG 1080p
          </span>
          <span class="px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">
            ⚡ Drag & Drop Táctil (Móvil y PC)
          </span>
          <span class="px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300 font-mono">
            🏆 37 Frutas Oficiales
          </span>
        </div>
      </div>

      <!-- Top Ad Placement -->
      <div class="my-6">
        <AdBanner slot="top-banner" format="horizontal" />
      </div>

      <!-- Main Interactive Tier List Maker Component -->
      <TierListMaker locale={locale} />

      <!-- Mid-page Ad Placement -->
      <div class="my-10">
        <AdBanner slot="middle-banner" format="horizontal" />
      </div>

      <!-- Comprehensive Editorial Breakdown (E-E-A-T AdSense Authority) -->
      <section class="max-w-4xl mx-auto space-y-12 text-slate-300 leading-relaxed">
        
        <!-- Section 1: Tier S+ Analysis -->
        <div class="p-8 rounded-3xl bg-[#0b0f19]/80 border border-white/10 backdrop-blur-xl space-y-4">
          <h2 class="text-2xl font-bold text-white flex items-center gap-3">
            <span class="p-2 rounded-xl bg-red-500/10 text-red-400 text-xl">🔥</span>
            Análisis de las Frutas Tier S+ (Dioses del Meta 2026)
          </h2>
          <p>
            El balance competitivo de Blox Fruits ha evolucionado notablemente. Actualmente, tres frutas destacan por encima de todo el catálogo por su absurda versatilidad:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 space-y-2">
              <span class="text-2xl">🦊</span>
              <h3 class="font-bold text-white text-base">Kitsune (Mítica)</h3>
              <p class="text-xs text-slate-400">
                Velocidad insuperable, pasiva de fuego místico y transformación bestial que permite huir o cazar a cualquier rival en segundos.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 space-y-2">
              <span class="text-2xl">🌀</span>
              <h3 class="font-bold text-white text-base">Portal (Legendaria)</h3>
              <p class="text-xs text-slate-400">
                La fruta de movilidad absoluta. En manos de un espadachín habilidoso, su dimensión paralela y teleportación garantizan victorias 1v1.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 space-y-2">
              <span class="text-2xl">✨</span>
              <h3 class="font-bold text-white text-base">Buddha (Legendaria)</h3>
              <p class="text-xs text-slate-400">
                La reina inmutable de las Raids y el farmeo del Tercer Mar. Con 50% de escudo de daño pasivo y rango infinito de espada.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 2: Internal Linking with other tools -->
        <div class="p-8 rounded-3xl bg-gradient-to-r from-indigo-950/40 via-purple-950/20 to-black/40 border border-indigo-500/20 space-y-4">
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span>🔗</span>
            <span>Herramientas Relacionadas para Jugadores de Blox Fruits</span>
          </h2>
          <p class="text-sm text-slate-300">
            Maximiza tu cuenta utilizando el resto de utilidades exclusivas de nuestro portal:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <a 
              href="/es/calculadora-tradeos-blox-fruits/" 
              class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 transition-colors group"
            >
              <span class="text-2xl">⚖️</span>
              <div>
                <span class="font-bold text-white group-hover:text-amber-300 text-sm block">Calculadora de Tradeos W/F/L</span>
                <span class="text-xs text-slate-400 block">Valores oficiales de Beli y demanda</span>
              </div>
            </a>

            <a 
              href="/es/quiz-frutas-blox-fruits/" 
              class="p-4 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center gap-3 transition-colors group"
            >
              <span class="text-2xl">🧠</span>
              <div>
                <span class="font-bold text-white group-hover:text-purple-300 text-sm block">Quiz de Personalidad de Fruta</span>
                <span class="text-xs text-slate-400 block">Descubre tu build y fruta ideal</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Editorial Review Card (E-E-A-T) -->
        <div class="p-6 rounded-3xl bg-black/40 border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-amber-500 to-rose-500 p-0.5">
              <div class="w-full h-full bg-[#0b0f19] rounded-[14px] flex items-center justify-center text-2xl font-black text-amber-400">
                GC
              </div>
            </div>
            <div>
              <span class="text-xs font-mono text-amber-400 uppercase tracking-wider block">Redactor & Analista Competitivo</span>
              <span class="text-base font-bold text-white block">Guillechum</span>
              <span class="text-xs text-slate-400 block">Revisado por Pepote y Thedrittus</span>
            </div>
          </div>

          <div class="text-right text-xs font-mono text-slate-400">
            <span class="block">Meta verificado:</span>
            <span class="text-white font-bold">Blox Fruits Update 24 (2026)</span>
          </div>
        </div>

      </section>

      <!-- Bottom Ad Placement -->
      <div class="my-10">
        <AdBanner slot="bottom-banner" format="horizontal" />
      </div>

    </div>
  </main>
</Layout>
