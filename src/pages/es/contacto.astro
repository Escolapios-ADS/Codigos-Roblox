---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/translations';
import { buildContactPageSchema } from '../../utils/structuredData';

const locale = 'es';
const t = getTranslations(locale);

const canonicalUrl = 'https://codigosroblox.org/es/contacto/';
const pageSchema = {
  '@graph': buildContactPageSchema(locale, canonicalUrl)
};
---

<Layout
  title="Contacto y Reporte de Códigos | CódigosRoblox.org"
  description="Contacta con el equipo de CódigosRoblox.org para enviar nuevos códigos, reportar códigos caducados o consultas de publicidad y colaboraciones."
  locale={locale}
  pageType="ContactPage"
  schema={pageSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    
    <!-- Header -->
    <div class="space-y-3 border-b border-white/10 pb-6">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
        <span>📬</span>
        <span>Atención a la Comunidad y Desarrolladores</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Contacto y Soporte
      </h1>
      <p class="text-sm text-slate-300 max-w-2xl">
        ¿Has encontrado un código nuevo que no tenemos en la lista? ¿Uno de los códigos ha caducado? ¿Eres un creador de juegos y quieres que verifiquemos tu experiencia? Escríbenos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Direct Contact Channels -->
      <div class="space-y-4 md:col-span-1">
        <div class="bg-[#0d1322] border border-white/10 rounded-2xl p-5 space-y-3">
          <div class="text-2xl">📧</div>
          <h3 class="text-sm font-bold text-white">Correo Electrónico</h3>
          <p class="text-xs text-slate-400">
            Respuesta en menos de 24 horas para consultas generales y colaboraciones.
          </p>
          <a href="mailto:soporte@codigosroblox.org" class="text-xs font-mono font-semibold text-indigo-400 hover:text-white transition-colors block">
            soporte@codigosroblox.org
          </a>
        </div>

        <div class="bg-[#0d1322] border border-white/10 rounded-2xl p-5 space-y-3">
          <div class="text-2xl">⏱️</div>
          <h3 class="text-sm font-bold text-white">Tiempo de Respuesta</h3>
          <p class="text-xs text-slate-400">
            Los reportes de códigos caídos o no funcionales se priorizan y se verifican en vivo en un plazo de 2 a 6 horas.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="md:col-span-2 bg-[#0d1322] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-6">
        <h2 class="text-xl font-bold text-white">Formulario de Contacto Directo</h2>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="reason" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Motivo del Mensaje
            </label>
            <select
              id="reason"
              name="reason"
              class="w-full bg-[#080c14] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-indigo-500 transition-colors"
            >
              <option value="broken-code">Reportar código que no funciona o caducado</option>
              <option value="new-code">Enviar un nuevo código que habéis olvidado</option>
              <option value="game-request">Solicitar añadir un nuevo juego de Roblox</option>
              <option value="business">Propuesta comercial o de publicidad</option>
              <option value="other">Otra consulta general</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Tu Nombre o Alias
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Alex_Gamer"
                class="w-full bg-[#080c14] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
                Tu Correo Electrónico
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full bg-[#080c14] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 transition-colors"
              />
            </div>
          </div>

          <div>
            <label for="game" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Juego de Roblox (opcional)
            </label>
            <input
              type="text"
              id="game"
              name="game"
              placeholder="Ej. Blox Fruits, Blade Ball, DTI..."
              class="w-full bg-[#080c14] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 transition-colors"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Detalle del Mensaje o Códigos
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Indícanos qué código falló, o qué código nuevo encontraste y su recompensa..."
              class="w-full bg-[#080c14] border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-400 focus:outline-none focus:border-indigo-500 transition-colors"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 px-6 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-600/30 border border-indigo-400/30 transition-all flex items-center justify-center gap-2"
          >
            <span>Enviar Mensaje al Equipo Editorial</span>
            <span>→</span>
          </button>
        </form>

        <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm text-center">
          ✅ ¡Mensaje recibido con éxito! Nuestro equipo lo revisará y actualizará la lista en caso necesario.
        </div>
      </div>

    </div>
  </div>
</Layout>

<script is:inline>
  const contactForm = document.getElementById('contact-form');
  const formSuccess = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  if (contactForm && formSuccess && submitBtn) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      
      setTimeout(() => {
        contactForm.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      }, 700);
    });
  }
</script>
