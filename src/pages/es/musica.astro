---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import SongCard from '../../components/SongCard.astro';
import { songsData } from '../../data/songs';
import { getTranslations } from '../../i18n/translations';

const locale = 'es';
const t = getTranslations(locale);

const pageTitle = 'Códigos de Música Roblox 2026 | Boombox IDs Funcionando';
const pageDescription = 'Lista de códigos de música de Roblox para 2026. Encuentra canciones virales de TikTok, Phonk y Pop con copia en 1 clic para Brookhaven RP y Da Hood.';

// Schema.org FAQ & Breadcrumbs
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Cómo poner música en la radio de Brookhaven RP?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En Brookhaven RP, abre el menú de accesorios o vehículos, equipa el Boombox (o radio del coche), haz clic sobre él para abrir la ventana de música, pega el ID numérico de nuestra lista y presiona Play.'
          }
        },
        {
          '@type': 'Question',
          name: '¿Por qué algunos códigos de música de Roblox no suenan?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En 2022, Roblox implementó una actualización de privacidad de audio que hizo privados los audios de más de 6 segundos creados por usuarios. Todos los códigos de nuestra lista han sido comprobados manualmente en 2026 y son audios de acceso público con permisos globales de reproducción.'
          }
        },
        {
          '@type': 'Question',
          name: '¿Son gratis estos códigos de canciones?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí, los códigos de canciones (AssetId) son 100% gratuitos. Sin embargo, algunos juegos como Da Hood pueden requerir un pase de juego (Gamepass de Boombox) para equipar la radio en el servidor.'
          }
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://codigosroblox.org/es/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Códigos de Música',
          item: 'https://codigosroblox.org/es/musica/'
        }
      ]
    }
  ]
};

const genres = [
  { id: 'all', label: 'Todos los Géneros', emoji: '🎵' },
  { id: 'trending', label: 'En Tendencia', emoji: '🔥' },
  { id: 'phonk', label: 'Phonk & Bass', emoji: '⚡' },
  { id: 'pop', label: 'Pop & Viral Hits', emoji: '✨' },
  { id: 'anime', label: 'Anime OST', emoji: '🎌' },
  { id: 'meme', label: 'Memes & Trolls', emoji: '🤣' },
  { id: 'gaming', label: 'Gaming OST', emoji: '🎮' },
  { id: 'trap', label: 'Trap & Urbano', emoji: '🎧' },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <!-- Top Leaderboard Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <AdBanner slotType="leaderboard" slotId="music-top-leaderboard" locale={locale} />
  </div>

  <!-- Music Hero Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
      <a href={`/${locale}/`} class="hover:text-white transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-indigo-400 font-semibold">Códigos de Música & Boombox IDs</span>
    </nav>

    <div class="relative overflow-hidden bg-[#0d1322] border border-white/10 rounded-3xl p-6 sm:p-10 shadow-2xl">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 border border-indigo-500/20 text-indigo-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Verificado Hoy • Septiembre 2026</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          Códigos de Música de Roblox <span class="bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400">(Boombox IDs)</span>
        </h1>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Biblioteca completa con los mejores IDs de canciones para la radio y el Boombox de <strong class="text-white">Brookhaven RP</strong>, <strong class="text-white">Da Hood</strong>, <strong class="text-white">Mic Up</strong> y juegos de catálogo. Copia el código numérico con 1 clic y ponlo a sonar en tu partida.
        </p>

        <!-- Search Bar -->
        <div class="pt-4 max-w-xl">
          <div class="relative flex items-center">
            <input
              type="text"
              id="music-search-input"
              placeholder="Buscar por canción, artista o género (ej. Phonk, Bad Bunny, JVKE)..."
              class="w-full pl-11 pr-4 py-3.5 bg-black/40 border border-white/15 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 rounded-2xl text-sm text-white placeholder-slate-400 outline-none transition-all shadow-inner"
              autocomplete="off"
            />
            <span class="absolute left-4 text-slate-400 text-lg">🔍</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Music Catalog Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-8">
    
    <!-- Genre Filter Pills -->
    <div class="flex flex-wrap items-center gap-2" id="genre-filters-container">
      {genres.map((g) => (
        <button
          type="button"
          class={`genre-btn px-4 py-2 rounded-xl text-xs font-bold transition-all border ${
            g.id === 'all'
              ? 'bg-indigo-600 text-white border-indigo-400 shadow-md shadow-indigo-600/30 active-genre'
              : 'bg-white/5 hover:bg-white/10 text-slate-300 border-white/10'
          }`}
          data-genre-filter={g.id}
        >
          <span>{g.emoji}</span> {g.label}
        </button>
      ))}
    </div>

    <!-- Active Song Count Indicator -->
    <div class="flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-white/5">
      <div>
        Mostrando <span id="visible-count" class="font-bold text-white">{songsData.length}</span> canciones verificadas
      </div>
      <div class="text-slate-400">
        Pruebas realizadas por <span class="text-indigo-400 font-semibold">Guillechum</span> y <span class="text-cyan-400 font-semibold">Pepote</span>
      </div>
    </div>

    <!-- Songs Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="songs-grid">
      {songsData.map((song) => (
        <SongCard song={song} locale={locale} />
      ))}
    </div>

    <!-- No results message -->
    <div id="no-music-results" class="hidden py-16 text-center space-y-4 bg-white/[0.01] border border-white/5 rounded-3xl p-8">
      <div class="text-4xl">📻</div>
      <h3 class="text-lg font-bold text-white">No se encontraron canciones</h3>
      <p class="text-xs text-slate-400 max-w-md mx-auto">
        Prueba a buscar con otra palabra clave o restablece los filtros para ver todo el catálogo disponible.
      </p>
      <button
        type="button"
        id="reset-music-filter-btn"
        class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-white border border-white/10 transition-colors"
      >
        Ver todas las canciones
      </button>
    </div>

    <!-- Mid-Catalog Ad Placement -->
    <div class="py-4">
      <AdBanner slotType="horizontal" slotId="music-mid-catalog-banner" locale={locale} />
    </div>

    <!-- How to use Boombox in Brookhaven & Da Hood -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4">
      
      <!-- Guide 1: Brookhaven RP -->
      <div class="bg-[#0b101d] border border-white/10 rounded-2xl p-6 sm:p-7 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-xl">
            🏡
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Cómo usar la radio en Brookhaven RP</h3>
            <p class="text-xs text-indigo-400">Paso a paso para principiantes</p>
          </div>
        </div>

        <ol class="space-y-3 text-xs text-slate-300 leading-relaxed list-decimal list-inside">
          <li>Abre <strong>Brookhaven RP</strong> en tu dispositivo móvil, PC o consola.</li>
          <li>En el lateral de la pantalla, pulsa el menú de <strong>Accesorios / Props</strong> y selecciona la <strong>Radio / Boombox</strong> (o sube a cualquier coche).</li>
          <li>Haz clic sobre el icono del Boombox para desplegar la pantalla de control.</li>
          <li>Copia cualquiera de los IDs de nuestra web y pégalo en la casilla <strong>Roblox ID</strong>.</li>
          <li>Presiona <strong>Play</strong> y la música empezará a sonar para todos los jugadores cercanos en el servidor.</li>
        </ol>
      </div>

      <!-- Guide 2: Da Hood -->
      <div class="bg-[#0b101d] border border-white/10 rounded-2xl p-6 sm:p-7 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-xl">
            🥊
          </div>
          <div>
            <h3 class="text-base font-bold text-white">Cómo usar el Boombox en Da Hood</h3>
            <p class="text-xs text-amber-300">Pase de Radio y Comandos</p>
          </div>
        </div>

        <ol class="space-y-3 text-xs text-slate-300 leading-relaxed list-decimal list-inside">
          <li>Entra en <strong>Da Hood</strong> asegurándote de contar con el pase de juego de Boombox.</li>
          <li>Equipa la radio en la mano desde tu inventario de armas y herramientas.</li>
          <li>Haz clic con la radio equipada para abrir la ventana emergente de audio.</li>
          <li>Introduce el código numérico de la canción que desees reproducir.</li>
          <li>Asegúrate de no tener el volumen de audio silenciado en los ajustes de Roblox.</li>
        </ol>
      </div>

    </div>

    <!-- Roblox Audio Privacy Notice (E-E-A-T) -->
    <div class="bg-indigo-950/20 border border-indigo-500/20 rounded-2xl p-6 space-y-2">
      <div class="flex items-center gap-2 text-indigo-300 font-bold text-sm">
        <span>ℹ️</span>
        <span>Aviso importante sobre los códigos de música de Roblox (Actualización de Privacidad)</span>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        Desde la actualización de licencias de audio de Roblox, muchas canciones subidas por usuarios se configuraron como privadas y ya no suenan en juegos públicos. Nuestro equipo editorial (<strong>Guillechum</strong>, <strong>Pepote</strong> y <strong>Thedrittus</strong>) prueba manualmente cada código en servidores públicos de <strong>Brookhaven RP</strong> y <strong>Da Hood</strong> para verificar que se encuentren en la biblioteca de dominio público de Roblox y suenen con total nitidez.
      </p>
    </div>

    <!-- Pre-FAQ Ad Slot -->
    <AdBanner slotType="horizontal" slotId="music-pre-faq-banner" locale={locale} />

    <!-- FAQ Section -->
    <div class="space-y-4 pt-4">
      <h2 class="text-2xl font-black text-white tracking-tight">
        Preguntas Frecuentes sobre Códigos de Música
      </h2>

      <div class="space-y-3">
        <div class="bg-[#0b101d] border border-white/10 rounded-2xl p-5">
          <h3 class="text-sm font-bold text-white mb-2">¿Cómo consigo un Boombox en Roblox?</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            En algunos juegos como Brookhaven RP o Catalog Avatar Creator, la radio es gratuita para todos los jugadores. En otros juegos de acción como Da Hood o Murder Mystery 2, el Boombox se vende como un pase de juego (Gamepass) en la tienda del juego a cambio de Robux.
          </p>
        </div>

        <div class="bg-[#0b101d] border border-white/10 rounded-2xl p-5">
          <h3 class="text-sm font-bold text-white mb-2">¿Puedo poner cualquier canción de YouTube o Spotify?</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            No directamente. En Roblox solo puedes reproducir audios que tengan un código numérico de activo (AssetId) registrado en los servidores de la plataforma. Por ello, en nuestro portal recopilamos y catalogamos los IDs válidos para que no tengas que buscarlos manualmente.
          </p>
        </div>

        <div class="bg-[#0b101d] border border-white/10 rounded-2xl p-5">
          <h3 class="text-sm font-bold text-white mb-2">¿Con qué frecuencia se añaden canciones nuevas?</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Actualizamos nuestra lista semanalmente agregando los temas virales de TikTok, lanzamientos de Phonk y aperturas de anime más solicitadas por la comunidad.
          </p>
        </div>
      </div>
    </div>

  </section>

  <!-- Client-side filtering script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('music-search-input');
      const genreButtons = document.querySelectorAll('.genre-btn');
      const cards = document.querySelectorAll('.song-card');
      const countEl = document.getElementById('visible-count');
      const noResults = document.getElementById('no-music-results');
      const resetBtn = document.getElementById('reset-music-filter-btn');

      let currentGenre = 'all';
      let currentQuery = '';

      function filterSongs() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const artist = card.getAttribute('data-artist') || '';
          const code = card.getAttribute('data-code') || '';
          const genre = card.getAttribute('data-genre') || '';
          const isTrending = card.getAttribute('data-trending') === 'true';

          // Check genre filter
          let matchesGenre = false;
          if (currentGenre === 'all') {
            matchesGenre = true;
          } else if (currentGenre === 'trending') {
            matchesGenre = isTrending;
          } else {
            matchesGenre = genre === currentGenre;
          }

          // Check search query
          const matchesQuery = !currentQuery || 
            title.includes(currentQuery) || 
            artist.includes(currentQuery) || 
            code.includes(currentQuery);

          if (matchesGenre && matchesQuery) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countEl) countEl.textContent = String(visibleCount);
        if (noResults) {
          if (visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target.value || '').trim().toLowerCase();
          filterSongs();
        });
      }

      genreButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          genreButtons.forEach((b) => {
            b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-genre');
            b.classList.add('bg-white/5', 'text-slate-300', 'border-white/10');
          });

          btn.classList.remove('bg-white/5', 'text-slate-300', 'border-white/10');
          btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-genre');

          currentGenre = btn.getAttribute('data-genre-filter') || 'all';
          filterSongs();
        });
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          currentGenre = 'all';

          genreButtons.forEach((b) => {
            if (b.getAttribute('data-genre-filter') === 'all') {
              b.classList.add('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-genre');
              b.classList.remove('bg-white/5', 'text-slate-300', 'border-white/10');
            } else {
              b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-genre');
              b.classList.add('bg-white/5', 'text-slate-300', 'border-white/10');
            }
          });

          filterSongs();
        });
      }
    });
  </script>
</Layout>
