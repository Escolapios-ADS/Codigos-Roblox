---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import FruitQuiz from '../../components/FruitQuiz.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'es';
const t = getTranslations(locale);

const pageTitle = 'Quiz Blox Fruits 2026: ¿Qué Fruta eres? | CódigosRoblox';
const pageDescription = 'Test interactivo de Blox Fruits 2026. Responde 7 preguntas de combate y descubre tu fruta ideal (Kitsune, Buddha, Dough o Dragon) con stats recomendadas.';

// Schema.org FAQ & Breadcrumbs
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Cuál es la mejor fruta para subir de nivel rápido en Blox Fruits?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'La fruta Buda (Buddha Awakened) es indiscutiblemente la mejor fruta para subir de nivel (grinding) en Blox Fruits. Al transformarte, multiplicas el alcance de tu espada o estilo de lucha y reduces un 50% todo el daño recibido, permitiendo derrotar grupos enteros de NPCs sin perder salud.'
          }
        },
        {
          '@type': 'Question',
          name: '¿Cuál es la fruta más rota para PvP en 2026?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'En 2026, las frutas dominantes del meta PvP de 30M Bounty son Kitsune (por su velocidad absurda e inmunidad al agua), Dough Despertada (por su combinación infinita de aturdimientos 1-shot) y Portal (para usuarios de espada con gran movilidad).'
          }
        },
        {
          '@type': 'Question',
          name: '¿Cómo resetear mis estadísticas si me sale otra fruta en el test?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Puedes resetear tus puntos de estadísticas gratis usando códigos activos de Blox Fruits (que ofrecen reembolso de estadísticas gratuito como SUB2GAMERROBOT_RESET1) o pagando 2,500 Fragmentos al NPC Plokster en el Segundo y Tercer Mar.'
          }
        },
        {
          '@type': 'Question',
          name: '¿Vale la pena comer una fruta mítica en el Primer Mar?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No es recomendable comer frutas míticas como Kitsune, Dragon o Leopard en el Primer Mar (Sea 1) porque exigen un dominio de maestría (Mastery) extremadamente alto que ralentizará tu subida de nivel. En Sea 1 es mucho mejor usar frutas elementales como Luz (Light) o Magma.'
          }
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Inicio',
          item: 'https://codigosroblox.org/es/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Quiz Blox Fruits',
          item: 'https://codigosroblox.org/es/quiz-frutas-blox-fruits/'
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <!-- Top Leaderboard Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <AdBanner slotType="leaderboard" slotId="quiz-top-leaderboard" locale={locale} />
  </div>

  <!-- Breadcrumbs & Hero -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4">
      <a href={`/${locale}/`} class="hover:text-indigo-400 transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-amber-400 font-medium">Quiz de Frutas Blox Fruits</span>
    </nav>

    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold">
        <span>🧠</span>
        <span>Test Interactivo de Personalidad • Temporada 2026</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        ¿Qué Fruta de Blox Fruits se Adapta a ti? <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-purple-300 to-pink-400">Quiz 2026</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
        ¿No sabes si comer Kitsune, despertar Masa (Dough), equipar Portal o seguir con Buda? Responde estas 7 preguntas rápidas sobre tus hábitos de combate y descubre tu fruta perfecta junto a la build de estadísticas recomendada para dominar los tres mares.
      </p>
    </div>
  </div>

  <!-- Main Quiz Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-12">
    
    <!-- Interactive Quiz Component -->
    <FruitQuiz locale={locale} />

    <!-- In-Content Ad Banner -->
    <AdBanner slotType="banner" slotId="quiz-mid-banner" locale={locale} />

    <!-- Educational & High-Value SEO Content Section -->
    <article class="bg-[#0b0f19] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-10 text-slate-300">
      
      <!-- Section 1: Guide by Sea -->
      <section class="space-y-4">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <span>🌊</span> Cómo Elegir Fruta Según el Mar en el que te Encuentres
        </h2>
        <p class="text-sm leading-relaxed">
          Cometer el error de consumir una fruta equivocada en una fase temprana puede arruinar tu velocidad de progresión. Sigue esta regla de oro diseñada por nuestro equipo editorial de veteranos con 30M Bounty:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
            <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">Primer Mar (Niv. 1 - 700)</span>
            <h4 class="text-base font-bold text-white">Frutas Elementales / Logia</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Prioriza frutas como <strong>Luz (Light)</strong>, <strong>Hielo (Ice)</strong> o <strong>Magma</strong>. Su inmunidad pasiva a golpes físicos de NPCs sin Haki te permitirá completar misiones sin recibir daño y viajar rápido entre islas volando.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
            <span class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider">Segundo Mar (Niv. 700 - 1500)</span>
            <h4 class="text-base font-bold text-white">Reinado de Buda & Despertares</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Consigue <strong>Buda (Buddha)</strong> y despierta su primer movimiento (Shift). Pon tus puntos en Melé y Defensa para arrasar en las Raids de Factory y subir al Tercer Mar en tiempo récord.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
            <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider">Tercer Mar (Niv. 1500 - 2600+)</span>
            <h4 class="text-base font-bold text-white">Meta PvP & Bounty Hunting</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Con nivel máximo desbloqueado, da el salto a frutas Míticas competitivas como <strong>Kitsune</strong>, <strong>Dough Despertada</strong>, <strong>Portal</strong> o <strong>Dragon</strong> para cazar Bounty de 30M en combates 1v1.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 2: Stat Build Rules -->
      <section class="space-y-4 border-t border-white/5 pt-8">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <span>⚖️</span> El Error Clásico de Estadísticas que Destroza tu Personaje
        </h2>
        <p class="text-sm leading-relaxed">
          Muchos jugadores novatos reparten sus puntos de estadísticas entre los 5 atributos (Cuerpo a cuerpo, Defensa, Espada, Pistola y Fruta Blox). Esto es un error crítico:
        </p>
        <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/20 text-xs space-y-2 text-rose-200">
          <p class="font-bold">⚠️ Regla del Meta de Blox Fruits (Especialización Estricta):</p>
          <p class="text-slate-300 leading-relaxed">
            Siempre debes maximizar únicamente <strong>TRES estadísticas</strong> a su tope (2550 puntos cada una):
          </p>
          <ul class="list-disc list-inside space-y-1 text-slate-300">
            <li><strong>Si eres Fruit Main (Usuario de Fruta):</strong> 2550 Melé + 2550 Defensa + 2550 Blox Fruit (0 en Espada y Pistola).</li>
            <li><strong>Si eres Sword Main (Espadachín):</strong> 2550 Melé + 2550 Defensa + 2550 Espada (0 en Blox Fruit y Pistola).</li>
          </ul>
        </div>
      </section>

      <!-- Section 3: Author Review Box (E-E-A-T) -->
      <div class="p-5 rounded-2xl bg-amber-950/30 border border-amber-500/20 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-amber-600/30 border border-amber-400 flex items-center justify-center text-lg font-bold text-white">
            PP
          </div>
          <div>
            <span class="text-xs text-amber-400 font-mono uppercase tracking-wider block">Escrito y Verificado por</span>
            <h4 class="text-sm font-bold text-white">Pepote • Especialista en Blox Fruits & Cazador de 30M Bounty</h4>
            <p class="text-xs text-slate-400">Revisado técnicamente por Guillechum y Thedrittus • Actualizado para 2026</p>
          </div>
        </div>
        <a 
          href={`/${locale}/sobre-nosotros/`}
          class="text-xs font-semibold px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-amber-300 border border-amber-500/30 transition-colors shrink-0"
        >
          Conoce al Equipo Editorial →
        </a>
      </div>

    </article>

    <!-- FAQ Section -->
    <section class="bg-[#0b0f19] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6">
      <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
        <span>❓</span> Preguntas Frecuentes sobre Frutas de Blox Fruits
      </h2>
      <div class="divide-y divide-white/5">
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">¿Pierdo mi fruta actual si como otra fruta nueva?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Sí. Si comes una fruta física de tu inventario, sustituirá inmediatamente a tu fruta activa. Sin embargo, si compraste una fruta permanente con Robux, puedes volver a equiparla gratis en el distribuidor en cualquier momento.
          </p>
        </div>
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">¿Cuál es la fruta más cara del juego en tradeos?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Actualmente, la fruta Kitsune y la fruta Dragón (por la expectación de su rework masivo) poseen los valores de tradeo más altos del mercado en 2026, rondando entre 90M y 115M de valor comercial.
          </p>
        </div>
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">¿Cómo puedo calcular si mi tradeo de fruta es justo?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Puedes utilizar nuestra <strong>Calculadora de Tradeos de Blox Fruits</strong> gratuita, que analiza en tiempo real el valor de mercado, la demanda y la regla del 40% de diferencia de Beli.
          </p>
        </div>
      </div>
    </section>

    <!-- Cross-links to other tools -->
    <section class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <a 
        href={`/${locale}/calculadora-tradeos-blox-fruits/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-amber-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">⚖️</span>
        <h4 class="font-bold text-white group-hover:text-amber-300 text-sm">Calculadora Blox Fruits</h4>
        <p class="text-xs text-slate-400">Valores W/F/L de todas las frutas.</p>
      </a>
      <a 
        href={`/${locale}/juego/blox-fruits`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-purple-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🎁</span>
        <h4 class="font-bold text-white group-hover:text-purple-300 text-sm">Códigos Blox Fruits</h4>
        <p class="text-xs text-slate-400">2x EXP y stat resets gratis.</p>
      </a>
      <a 
        href={`/${locale}/codigos-ropa-brookhaven/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-pink-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">👗</span>
        <h4 class="font-bold text-white group-hover:text-pink-300 text-sm">Ropa Brookhaven RP</h4>
        <p class="text-xs text-slate-400">Outfits militares y anime.</p>
      </a>
      <a 
        href={`/${locale}/musica/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-indigo-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🎵</span>
        <h4 class="font-bold text-white group-hover:text-indigo-300 text-sm">Boombox IDs</h4>
        <p class="text-xs text-slate-400">Canciones virales con 1 clic.</p>
      </a>
    </section>

    <!-- Bottom Ad Slot -->
    <AdBanner slotType="rectangle" slotId="quiz-bottom-rect" locale={locale} />

  </main>
</Layout>
