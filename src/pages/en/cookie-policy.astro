---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'en';
const t = getTranslations(locale);
const lastUpdated = 'September 23, 2026';

const pageTitle = 'Cookie Policy & Consent Management | RobloxCodes';
const pageDescription = 'Detailed guide on cookies used on RobloxCodes, Google AdSense cookies, retention periods, and how to configure or revoke your consent.';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'RobloxCodes',
    url: 'https://codigosroblox.org/en'
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    
    <!-- Header -->
    <div class="space-y-3 border-b border-white/10 pb-8 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
        <span>🍪</span>
        <span>Cookie Information & ePrivacy Compliance</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Cookie Policy
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Last updated: {lastUpdated} • Compliant with EU ePrivacy Directive, GDPR, and Google User Consent Policies.
      </p>
    </div>

    <!-- Interactive Manager Callout -->
    <div class="bg-indigo-950/30 border border-indigo-500/20 rounded-2xl p-5 sm:p-6 space-y-3">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="space-y-1">
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <span>⚙️</span>
            <span>Cookie Consent & Preferences Center</span>
          </h2>
          <p class="text-xs text-slate-300">
            You can review, alter, or revoke your cookie consent anytime with one click.
          </p>
        </div>
        <button 
          type="button" 
          id="cookie-policy-reset-btn"
          class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-lg shadow-indigo-600/20 transition-all shrink-0"
        >
          Reopen Consent Banner
        </button>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="space-y-8 text-sm text-slate-300 leading-relaxed">
      
      <!-- Section 1 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">1.</span>
          <span>What Are Cookies?</span>
        </h2>
        <p>
          A <strong>cookie</strong> is a small alphanumeric text snippet saved to your web browser when visiting web pages. Cookies allow platforms to remember user settings, enable dark-mode caching, preserve language choices, and display contextual or personalized advertisements through ad networks like <strong>Google AdSense</strong>.
        </p>
        <p class="text-xs text-slate-400">
          Cookies used across RobloxCodes.org <strong>do not harm your hardware, execute programs, or carry viruses</strong>. We never store Roblox account credentials, passwords, or payment cards.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">2.</span>
          <span>Cookie Categories by Purpose</span>
        </h2>
        <div class="space-y-4">
          <div class="border-l-2 border-emerald-500 pl-4 space-y-1">
            <h3 class="text-white font-bold text-sm">A. Strictly Necessary & Technical Cookies (Exempt from consent)</h3>
            <p class="text-xs text-slate-400">
              Essential for platform stability and navigation. These maintain your language toggle, consent decision state, and security firewalls. They cannot be turned off within our systems.
            </p>
          </div>

          <div class="border-l-2 border-indigo-500 pl-4 space-y-1">
            <h3 class="text-white font-bold text-sm">B. Performance & Analytics Cookies (Consent required)</h3>
            <p class="text-xs text-slate-400">
              Help us measure aggregate traffic metrics, identify broken code pages, and track popular games. Telemetry is collected in aggregated, anonymized batches.
            </p>
          </div>

          <div class="border-l-2 border-purple-500 pl-4 space-y-1">
            <h3 class="text-white font-bold text-sm">C. Behavioral Advertising Cookies (Consent required)</h3>
            <p class="text-xs text-slate-400">
              Operated by third-party advertising partners, notably <strong>Google AdSense</strong>. These record non-personally identifiable visit habits across the web to build contextual interest profiles and display relevant ads.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Cookie Inventory Table -->
      <section class="space-y-4 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">3.</span>
          <span>Comprehensive Cookie Inventory</span>
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-white/10 rounded-xl overflow-hidden">
            <thead class="bg-white/5 text-slate-200 uppercase font-mono tracking-wider">
              <tr>
                <th class="p-3">Cookie Name</th>
                <th class="p-3">Provider</th>
                <th class="p-3">Purpose</th>
                <th class="p-3">Category</th>
                <th class="p-3">Lifespan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300 font-mono">
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3 font-bold text-emerald-400">roblox_cookie_consent</td>
                <td class="p-3">RobloxCodes (First-Party)</td>
                <td class="p-3 font-sans">Stores your consent preference (accepted / essential only).</td>
                <td class="p-3 font-sans text-emerald-400">Technical</td>
                <td class="p-3 font-sans">12 months</td>
              </tr>
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3 font-bold text-purple-400">__gads / __gpi</td>
                <td class="p-3">Google LLC (AdSense)</td>
                <td class="p-3 font-sans">Enables Google AdSense to serve ads and regulate impression caps.</td>
                <td class="p-3 font-sans text-purple-400">Advertising</td>
                <td class="p-3 font-sans">13 months</td>
              </tr>
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3 font-bold text-purple-400">IDE / DSID</td>
                <td class="p-3">DoubleClick (Google)</td>
                <td class="p-3 font-sans">Measures advertising efficiency and prevents duplicate ad displays.</td>
                <td class="p-3 font-sans text-purple-400">Advertising</td>
                <td class="p-3 font-sans">12 months</td>
              </tr>
              <tr class="hover:bg-white/[0.02]">
                <td class="p-3 font-bold text-indigo-400">_ga / _ga_*</td>
                <td class="p-3">Google LLC (Analytics)</td>
                <td class="p-3 font-sans">Measures anonymized page hits, game code lookups, and session bounce rate.</td>
                <td class="p-3 font-sans text-indigo-400">Analytics</td>
                <td class="p-3 font-sans">24 months</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 4: Browser Management Guide -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">4.</span>
          <span>Managing Cookies Directly in Your Browser</span>
        </h2>
        <p>
          You can configure, block, or delete cookies locally using your web browser settings:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-400">
          <li><strong>Google Chrome:</strong> Settings > Privacy and security > Third-party cookies.</li>
          <li><strong>Mozilla Firefox:</strong> Settings > Privacy & Security > Cookies and Site Data.</li>
          <li><strong>Apple Safari (macOS / iOS):</strong> Preferences / Settings > Safari > Privacy > Block all cookies.</li>
          <li><strong>Microsoft Edge:</strong> Settings > Cookies and site permissions > Manage and delete cookies.</li>
          <li><strong>Opera:</strong> Settings > Privacy & Security > Site Settings > Cookies.</li>
        </ul>
      </section>

      <!-- Section 5: Opt-Out Links -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">5.</span>
          <span>Official Industry Opt-Out Portals</span>
        </h2>
        <p>
          To opt out of interest-based programmatic advertising across major ad networks, use these free industry tools:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs pt-2">
          <a 
            href="https://myadcenter.google.com/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:border-indigo-500/50 hover:bg-white/10 transition-colors block"
          >
            <strong class="text-white block mb-0.5">Google My Ad Center</strong>
            <span class="text-slate-400">Customize ad topics and personalization across Google.</span>
          </a>
          <a 
            href="https://www.youronlinechoices.com/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:border-indigo-500/50 hover:bg-white/10 transition-colors block"
          >
            <strong class="text-white block mb-0.5">Your Online Choices (EDAA)</strong>
            <span class="text-slate-400">European digital advertising self-regulation portal.</span>
          </a>
          <a 
            href="https://optout.networkadvertising.org/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:border-indigo-500/50 hover:bg-white/10 transition-colors block"
          >
            <strong class="text-white block mb-0.5">Network Advertising Initiative (NAI)</strong>
            <span class="text-slate-400">Opt-out tool for member advertising networks.</span>
          </a>
          <a 
            href="https://www.aboutads.info/choices/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 rounded-xl bg-white/5 border border-white/10 hover:border-indigo-500/50 hover:bg-white/10 transition-colors block"
          >
            <strong class="text-white block mb-0.5">Digital Advertising Alliance (DAA)</strong>
            <span class="text-slate-400">Self-regulatory behavioral advertising choice platform.</span>
          </a>
        </div>
      </section>

    </div>

    <!-- Bottom cross-link -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>For complete information regarding data protection and terms of use:</p>
      <div class="flex items-center gap-3">
        <a href="/en/privacy" class="text-indigo-400 hover:text-indigo-300 underline font-medium">Privacy Policy</a>
        <span>•</span>
        <a href="/en/legal-notice" class="text-indigo-400 hover:text-indigo-300 underline font-medium">Legal Notice</a>
      </div>
    </div>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const resetBtn = document.getElementById('cookie-policy-reset-btn');
    const banner = document.getElementById('cookie-consent-banner');

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        localStorage.removeItem('roblox_cookie_consent');
        if (banner) {
          banner.classList.remove('translate-y-full');
          banner.scrollIntoView({ behavior: 'smooth' });
        } else {
          window.location.reload();
        }
      });
    }
  });
</script>
