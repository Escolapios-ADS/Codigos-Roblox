---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'en';
const t = getTranslations(locale);
const lastUpdated = 'September 23, 2026';

const pageTitle = 'Privacy & Cookie Policy | RobloxCodes';
const pageDescription = 'Comprehensive Privacy & Cookie Policy for RobloxCodes in strict compliance with GDPR (EU 2016/679), CCPA/CPRA, and Google AdSense publisher policies.';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'RobloxCodes',
    url: 'https://codigosroblox.org/en'
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    
    <!-- Header -->
    <div class="space-y-3 border-b border-white/10 pb-8 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
        <span>🔒</span>
        <span>Data Protection & Privacy Standards</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Privacy & Cookie Policy
      </h1>
      <p class="text-xs sm:text-sm text-slate-400">
        Last updated: {lastUpdated} • Compliant with GDPR (EU 2016/679), CCPA/CPRA (California), COPPA, and Google AdSense Publisher Policies.
      </p>
    </div>

    <!-- Summary Box -->
    <div class="bg-indigo-950/30 border border-indigo-500/20 rounded-2xl p-5 sm:p-6 space-y-2">
      <div class="flex items-center gap-2 text-indigo-400 font-bold text-sm sm:text-base">
        <span>✨</span>
        <h2>Your Privacy Summary on RobloxCodes</h2>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
        Browsing this website is <strong>100% free, registration-free, and anonymous</strong>. We never ask for Roblox account passwords, login credentials, or payment details. We only process minimal technical telemetry to optimize performance and display programmatic advertisements through <strong>Google AdSense</strong> with your consent.
      </p>
    </div>

    <!-- Content Sections -->
    <div class="space-y-8 text-sm text-slate-300 leading-relaxed">
      
      <!-- Section 1 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">1.</span>
          <span>Data Controller & Publisher Details</span>
        </h2>
        <p>
          At <strong>RobloxCodes.org</strong> (referred to as "the Platform", "We", or "Us"), we take digital privacy and regulatory transparency seriously.
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-400">
          <li><strong>Platform Title:</strong> RobloxCodes (CódigosRoblox.org)</li>
          <li><strong>Nature of Project:</strong> Independent gaming journalism, strategy walkthroughs, and public code catalog.</li>
          <li><strong>Editorial Management Team:</strong> Operated by <em>Guillechum</em>, <em>Pepote</em>, and <em>Thedrittus</em>.</li>
          <li><strong>Privacy Officer & Data Rights Email:</strong> <a href="mailto:clickerhunters@gmail.com" class="text-indigo-400 underline">clickerhunters@gmail.com</a> (or via our <a href="/en/contact" class="text-indigo-400 underline">Official Contact Form</a>).</li>
        </ul>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">2.</span>
          <span>Data Categories & Purposes of Processing</span>
        </h2>
        <p>
          Access to our game code directories and tools <strong>requires zero user registration</strong>. Data processed is strictly confined to:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-slate-400">
          <li>
            <strong>Anonymized Technical Data:</strong> Masked IP addresses, browser types, operating systems, and page request timestamps to ensure system security, mitigate automated abuse, and gauge network performance.
          </li>
          <li>
            <strong>Voluntarily Submitted Contact Details:</strong> When you report an expired code or send inquiries via our contact form, we only record the email address and message body you provide to reply to you.
          </li>
          <li>
            <strong>Technical & Advertising Cookies:</strong> To retain user preferences (such as language selection and cookie consent status) and display contextual or personalized programmatic ads through Google AdSense.
          </li>
        </ul>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">3.</span>
          <span>Legal Basis for Processing (GDPR Art. 6)</span>
        </h2>
        <p>
          We process personal data strictly in line with statutory lawful grounds:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-400">
          <li><strong>Explicit User Consent (GDPR Art. 6.1.a):</strong> For placing optional analytical and advertising cookies via our consent banner, and for handling voluntary user inquiry submissions.</li>
          <li><strong>Legitimate Interests (GDPR Art. 6.1.f):</strong> To secure web application endpoints, block cyber threats, and maintain fast, stable server infrastructure.</li>
        </ul>
      </section>

      <!-- Crucial Google AdSense Disclosure Section -->
      <section class="space-y-4 bg-[#0d1322] border border-indigo-500/30 rounded-2xl p-6 shadow-sm">
        <div class="flex items-center gap-2 text-indigo-400 font-bold text-base">
          <span>📢</span>
          <h2 class="text-lg font-bold text-white">4. Programmatic Advertising & Google AdSense DoubleClick Cookies</h2>
        </div>
        <p>
          This website uses <strong>Google AdSense</strong> (Google Ireland Limited / Google LLC) to fund high-speed servers and keep our databases 100% free for everyone.
        </p>
        <p class="font-medium text-white text-xs sm:text-sm">
          Under mandatory Google Publisher policies, we provide the following disclosures:
        </p>
        <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm text-slate-300">
          <li>
            Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to this website or other internet websites.
          </li>
          <li>
            Google's use of advertising cookies (including the <em>DoubleClick DART</em> cookie and modern behavioral signals) enables it and its partners to serve ads to users based on their visits to our site and/or other sites across the internet.
          </li>
          <li>
            Users may opt out of personalized advertising anytime by visiting:
            <div class="mt-2 pl-2 space-y-1">
              <div>
                👉 <strong>Google My Ad Center:</strong> 
                <a href="https://myadcenter.google.com/" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 underline ml-1 font-mono">
                  https://myadcenter.google.com/
                </a>
              </div>
              <div>
                👉 <strong>Google Ads Settings:</strong> 
                <a href="https://adssettings.google.com" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 underline ml-1 font-mono">
                  https://adssettings.google.com
                </a>
              </div>
              <div>
                👉 <strong>European Interactive Digital Advertising Alliance (EDAA):</strong> 
                <a href="https://www.youronlinechoices.com/" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 underline ml-1 font-mono">
                  www.youronlinechoices.com
                </a>
              </div>
              <div>
                👉 <strong>Network Advertising Initiative (NAI):</strong> 
                <a href="https://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 underline ml-1 font-mono">
                  optout.networkadvertising.org
                </a>
              </div>
            </div>
          </li>
        </ul>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">5.</span>
          <span>International Data Transfers & EU-US Data Privacy Framework</span>
        </h2>
        <p>
          Google services may process telemetry on servers located outside the European Economic Area (EEA), notably in the United States.
        </p>
        <p class="text-xs text-slate-400">
          Google LLC participates in and is certified under the <strong>EU-U.S. Data Privacy Framework (DPF)</strong>, recognized by the European Commission's adequacy decision of July 10, 2023, providing legally adequate safeguards for cross-border data transfers.
        </p>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">6.</span>
          <span>California Consumer Privacy Act (CCPA / CPRA Disclosures)</span>
        </h2>
        <p>
          Under the California Consumer Privacy Act (CCPA) and the California Privacy Rights Act (CPRA), California residents enjoy specific privacy rights:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm text-slate-400">
          <li><strong>We Do Not Sell Personal Information:</strong> We do not sell personal information for monetary consideration.</li>
          <li><strong>Right to Know & Delete:</strong> You have the right to request disclosure of personal data collected and request its permanent deletion.</li>
          <li><strong>Non-Discrimination:</strong> We will never discriminate against you for exercising your privacy rights.</li>
        </ul>
      </section>

      <!-- Section 7 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">7.</span>
          <span>Children's Privacy Protection (COPPA / GDPR)</span>
        </h2>
        <p>
          Given that the Roblox ecosystem attracts a large audience of younger players, <strong>we do not knowingly collect personal information from children under 13 (or under 16 in certain EU jurisdictions)</strong>.
        </p>
        <p class="text-xs text-slate-400">
          If you are a parent or legal guardian and believe your child has submitted personal details through our contact form, please reach out to <a href="mailto:clickerhunters@gmail.com" class="text-indigo-400 underline">clickerhunters@gmail.com</a> to request immediate deletion of that data.
        </p>
      </section>

      <!-- Section 8 -->
      <section class="space-y-3 bg-[#0d1322] border border-white/5 rounded-2xl p-6">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span class="text-indigo-400 font-mono">8.</span>
          <span>Your Legal Rights (GDPR Data Subject Rights)</span>
        </h2>
        <p>
          Under European regulations, you may exercise the following rights free of charge:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="bg-black/20 p-3 rounded-xl border border-white/5">
            <strong class="text-white block mb-1">Access & Rectification</strong>
            Request a copy of your records and correct any inaccurate information.
          </div>
          <div class="bg-black/20 p-3 rounded-xl border border-white/5">
            <strong class="text-white block mb-1">Erasure ("Right to be Forgotten")</strong>
            Request complete removal of your contact emails and correspondence history.
          </div>
          <div class="bg-black/20 p-3 rounded-xl border border-white/5">
            <strong class="text-white block mb-1">Objection & Restriction</strong>
            Object to data processing or request temporary suspension of processing activities.
          </div>
          <div class="bg-black/20 p-3 rounded-xl border border-white/5">
            <strong class="text-white block mb-1">Data Portability</strong>
            Receive your submitted data in a standard, machine-readable format.
          </div>
        </div>
        <p class="text-xs text-slate-400 pt-2">
          To exercise your rights, email us at <a href="mailto:clickerhunters@gmail.com" class="text-indigo-400 underline">clickerhunters@gmail.com</a>. You also have the right to lodge a complaint with your competent supervisory authority (such as the Spanish AEPD or your local EU Data Protection Authority).
        </p>
      </section>

      <!-- Section 9: Interactive Cookie Management -->
      <section class="space-y-4 bg-indigo-950/20 border border-indigo-500/20 rounded-2xl p-6">
        <div class="flex items-center gap-2 text-indigo-400 font-bold text-base">
          <span>🍪</span>
          <h2 class="text-lg font-bold text-white">9. Manage & Revoke Cookie Consent Anytime</h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-300">
          In line with ePrivacy directives, you can review or revoke your cookie choices whenever you want, just as easily as you granted them.
        </p>
        <div class="pt-2">
          <button 
            type="button" 
            id="reset-cookie-consent-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-all shadow-lg shadow-indigo-600/25"
          >
            <span>⚙️</span>
            <span>Reconfigure Cookie Preferences</span>
          </button>
          <span id="reset-cookie-status" class="text-xs text-emerald-400 font-medium ml-3 hidden">
            Preferences reset! The consent banner will now reappear.
          </span>
        </div>
      </section>

    </div>

    <!-- Bottom cross-link -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>For additional details regarding general terms of service:</p>
      <div class="flex items-center gap-3">
        <a href="/en/legal-notice" class="text-indigo-400 hover:text-indigo-300 underline font-medium">Legal Notice & Disclaimers</a>
        <span>•</span>
        <a href="/en/terms" class="text-indigo-400 hover:text-indigo-300 underline font-medium">Terms of Service</a>
      </div>
    </div>

  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const resetBtn = document.getElementById('reset-cookie-consent-btn');
    const statusMsg = document.getElementById('reset-cookie-status');
    const banner = document.getElementById('cookie-consent-banner');

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        localStorage.removeItem('roblox_cookie_consent');
        if (statusMsg) {
          statusMsg.classList.remove('hidden');
        }
        if (banner) {
          banner.classList.remove('translate-y-full');
          banner.scrollIntoView({ behavior: 'smooth' });
        } else {
          window.location.reload();
        }
      });
    }
  });
</script>
