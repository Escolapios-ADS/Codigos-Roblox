---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'en';
const t = getTranslations(locale);
const lastUpdated = 'September 22, 2026';
---

<Layout
  title="Terms of Service | RobloxCodes.org"
  description="Terms and conditions for utilizing the RobloxCodes.org gaming portal. Intellectual property, disclaimer of code warranties, and community rules."
  locale={locale}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    
    <div class="space-y-2 border-b border-white/10 pb-6">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
        <span>📜</span>
        <span>Terms & Conditions</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Terms of Service
      </h1>
      <p class="text-xs text-slate-400">
        Last Updated: {lastUpdated}
      </p>
    </div>

    <div class="space-y-6 text-sm text-slate-300 leading-relaxed">
      
      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">1. Agreement to Terms</h2>
        <p>
          By visiting and using <strong>RobloxCodes.org</strong>, you agree to be bound by these Terms of Service, our <a href="/en/legal-notice" class="text-indigo-400 underline font-medium">Legal Notice</a>, and our <a href="/en/privacy" class="text-indigo-400 underline font-medium">Privacy Policy</a>. If you do not agree with any provision of these terms, please discontinue use of the site immediately.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">2. Scope of Service</h2>
        <p>
          This website serves an exclusively educational and entertainment purpose. We provide free gameplay guides, walkthroughs, and compilations of public promotional codes released by independent creators on the Roblox platform. We do not sell virtual currencies, paid codes, or in-game assets.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">3. Disclaimer Regarding Codes</h2>
        <p>
          Promotional codes are created, activated, and deactivated solely at the discretion of respective game studios. While our team manually checks and verifies codes on active servers, we make no representation or warranty that any code will remain active indefinitely, as developers may expire rewards at any time without notice.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">4. Intellectual Property Rights</h2>
        <p>
          Roblox, its logos, wordmarks, and associated visual assets are the exclusive intellectual property of Roblox Corporation. Original content created on this website (guide texts, database architecture, design systems, and code) is protected by international copyright laws.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-bold text-white">5. Amendments to Terms</h2>
        <p>
          We reserve the right to revise or update these terms at our sole discretion to maintain operational compliance and user security.
        </p>
      </section>

    </div>
  </div>
</Layout>
