---
import Layout from '../../../layouts/Layout.astro';
import AdBanner from '../../../components/AdBanner.astro';
import { guidesData } from '../../../data/guides';
import { getTranslations } from '../../../i18n/translations';
import type { GuideItem } from '../../../types/guide';

export function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideItem;
}

const { guide } = Astro.props;
const locale = 'en';
const t = getTranslations(locale);

const pageTitle = guide.metaTitle?.[locale] || `${guide.title[locale]} | RobloxCodes`;
const pageDescription = guide.excerpt[locale];

import { buildGuideSchema } from '../../../utils/structuredData';

// Schema JSON-LD for Article & BreadcrumbList
const canonicalGuideUrl = `https://codigosroblox.org/${locale}/guias/${guide.slug}/`;
const pageSchema = {
  '@graph': buildGuideSchema(guide, locale, canonicalGuideUrl)
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  ogType="article"
  schema={pageSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-400">
      <a href={`/${locale}/`} class="hover:text-white transition-colors">{t.gameDetail.breadcrumbsHome}</a>
      <span>/</span>
      <a href={`/${locale}/guias/`} class="hover:text-white transition-colors">Guides</a>
      <span>/</span>
      <span class="text-indigo-400 font-semibold line-clamp-1">{guide.title[locale]}</span>
    </nav>

    <!-- Article Header -->
    <header class="space-y-4 border-b border-white/10 pb-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-indigo-500/10 border border-indigo-500/20 text-indigo-400">
          {guide.categoryLabel[locale]}
        </span>
        {guide.badge && (
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/10 border border-amber-500/20 text-amber-300">
            {guide.badge[locale]}
          </span>
        )}
        <span class="text-xs text-slate-400 font-mono">
          ⏱️ Read time: {guide.readTime}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        {guide.title[locale]}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        {guide.excerpt[locale]}
      </p>

      <!-- Author Box (E-E-A-T) -->
      <div class="flex items-center gap-4 pt-4 border-t border-white/5 text-xs text-slate-400">
        <div class="w-10 h-10 rounded-full bg-indigo-500/20 border border-indigo-500/30 flex items-center justify-center text-xl">
          {guide.author.avatar}
        </div>
        <div>
          <div class="font-bold text-slate-200">{guide.author.name}</div>
          <div class="text-[11px] text-indigo-400">{guide.author.role[locale]}</div>
        </div>
        <div class="ml-auto text-right text-[11px]">
          <div>Updated: <time datetime={guide.updatedDate}>{guide.updatedDate}</time></div>
          <div class="text-emerald-400 font-medium">● Fact-checked & verified</div>
        </div>
      </div>
    </header>

    <!-- AdBanner Placeholder (Top of article) -->
    <AdBanner slotType="horizontal" locale={locale} />

    <!-- Article Body Sections -->
    <article class="space-y-10 text-slate-300 leading-relaxed text-sm sm:text-base">
      {guide.sections.map((section, sIndex) => (
        <>
          <section class="space-y-4">
            <h2 class="text-2xl font-bold text-white tracking-tight pt-2 border-b border-white/5 pb-2">
              {section.heading[locale]}
            </h2>

            {section.content[locale].map((paragraph) => (
              <p class="leading-relaxed text-slate-300">
                {paragraph}
              </p>
            ))}

            {section.table && (
              <div class="overflow-x-auto my-6 border border-white/10 rounded-xl bg-[#0d1322]">
                <table class="w-full min-w-[550px] text-left text-xs sm:text-sm">
                  <thead class="bg-white/5 text-slate-200 border-b border-white/10 font-bold uppercase tracking-wider text-[11px]">
                    <tr>
                      {section.table.headers[locale].map((header) => (
                        <th class="p-3.5 sm:p-4">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-white/5">
                    {section.table.rows[locale].map((row) => (
                      <tr class="hover:bg-white/[0.02] transition-colors">
                        {row.map((cell, idx) => (
                          <td class={`p-3.5 sm:p-4 ${idx === 0 ? 'font-bold text-white' : 'text-slate-300'}`}>
                            {cell}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {section.callout && (
              <div class={`flex items-start gap-3 p-4 rounded-xl text-xs sm:text-sm ${
                section.callout.type === 'tip' 
                  ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-200'
                  : section.callout.type === 'warning'
                  ? 'bg-amber-500/10 border border-amber-500/30 text-amber-200'
                  : 'bg-indigo-500/10 border border-indigo-500/30 text-indigo-200'
              }`}>
                <span class="text-base shrink-0">
                  {section.callout.type === 'tip' ? '💡' : section.callout.type === 'warning' ? '⚠️' : 'ℹ️'}
                </span>
                <div>{section.callout.text[locale]}</div>
              </div>
            )}
          </section>

          {sIndex === 1 && (
            <div class="my-6">
              <AdBanner slotType="horizontal" slotId="guide-in-content-slot" locale={locale} />
            </div>
          )}
        </>
      ))}
    </article>

    <!-- In-article AdBanner -->
    <AdBanner slotType="horizontal" locale={locale} />

    <!-- Related Actions CTA -->
    <div class="bg-[#0d1322] border border-white/10 rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-lg font-bold text-white">Looking for working codes for this game?</h3>
        <p class="text-xs text-slate-400 mt-1">
          Check out our 1-click copy verified code tables updated daily.
        </p>
      </div>
      <a
        href={`/${locale}/#juegos`}
        class="shrink-0 px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-xs font-bold text-white transition-all shadow-lg shadow-indigo-600/25 border border-indigo-400/30"
      >
        View code database →
      </a>
    </div>

  </div>
</Layout>
