---
import Layout from '../../../layouts/Layout.astro';
import { guidesData } from '../../../data/guides';
import { getTranslations } from '../../../i18n/translations';
import AdBanner from '../../../components/AdBanner.astro';

const locale = 'en';
const t = getTranslations(locale);
---

<Layout
  title="Roblox Guides & Tier Lists (2026) | RobloxCodes"
  description="Master the biggest Roblox experiences: Blox Fruits Fruit Tier Lists, Blade Ball abilities, free Robux safely, and Dress to Impress styling tricks."
  locale={locale}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    
    <!-- Header -->
    <div class="space-y-3 text-center sm:text-left border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-indigo-400 bg-indigo-500/10 px-3 py-1 rounded-full border border-indigo-500/20">
        <span>📚</span>
        <span>Strategic Gaming Guides & Meta Analysis</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Roblox Guides & Tier Lists
      </h1>
      <p class="text-base text-slate-300 max-w-3xl">
        In-depth articles crafted by veteran players: meta evaluations, optimal stat spreads, grinding routes, and security practices.
      </p>
    </div>

    <!-- AdBanner Placeholder -->
    <AdBanner slotType="horizontal" locale={locale} />

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {guidesData.map((guide) => (
        <article class="group relative bg-[#0d1322] border border-white/10 hover:border-indigo-500/40 rounded-2xl p-6 sm:p-8 transition-all duration-300 hover:shadow-2xl hover:shadow-indigo-500/10 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-3">
              <span class="text-3xl">{guide.emoji}</span>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-indigo-500/10 border border-indigo-500/20 text-indigo-300">
                  {guide.categoryLabel[locale]}
                </span>
                <span class="text-xs text-slate-400 font-mono">
                  ⏱️ {guide.readTime}
                </span>
              </div>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-indigo-300 transition-colors leading-snug">
              <a href={`/${locale}/guias/${guide.slug}`}>
                <span class="absolute inset-0"></span>
                {guide.title[locale]}
              </a>
            </h2>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed line-clamp-3">
              {guide.excerpt[locale]}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-white/5 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2 text-slate-400">
              <span>{guide.author.avatar}</span>
              <span class="font-medium text-slate-300">{guide.author.name}</span>
            </div>
            <span class="text-indigo-400 font-bold group-hover:translate-x-1 transition-transform flex items-center gap-1">
              <span>Read guide</span>
              <span>→</span>
            </span>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>
