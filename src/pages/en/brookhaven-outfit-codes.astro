---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import OutfitHub from '../../components/OutfitHub.astro';
import { getTranslations } from '../../i18n/translations';

const locale = 'en';
const t = getTranslations(locale);

const pageTitle = 'Brookhaven RP Outfit Codes 2026 | Clothes IDs, Military, Aesthetic & Hair';
const pageDescription = 'Updated & verified Brookhaven RP outfit codes and clothes IDs for 2026. 1-click copy shirt, pants, hair, anime cosplay, and military gear IDs for boys and girls.';

// Schema.org FAQ & Breadcrumbs
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do you put outfit codes in Brookhaven RP?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In Brookhaven RP, click the Avatar Editor icon (pencil and avatar) on the right sidebar. Navigate to the tab labeled "ID", paste the numeric Asset ID copied from our catalog, and press Enter. The clothes equip immediately on your character.'
          }
        },
        {
          '@type': 'Question',
          name: 'Are these Brookhaven outfit codes free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes! Using clothes IDs inside the Brookhaven RP avatar editor is 100% free and costs zero Robux. You can change into as many styles as you wish.'
          }
        },
        {
          '@type': 'Question',
          name: 'Why do some clothes IDs not load or appear invisible?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'If a clothing piece fails to load, it is usually because the creator deleted the texture or a Product ID was entered instead of an Asset ID. All codes on CodigosRoblox.org are verified 2026 Asset IDs tested for Brookhaven.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can I combine these outfits with Brookhaven music codes?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Absolutely! Pair your tactical military or pastel aesthetic outfit with trending boombox songs using our Brookhaven Music IDs hub.'
          }
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://codigosroblox.org/en/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Brookhaven Outfit Codes',
          item: 'https://codigosroblox.org/en/brookhaven-outfit-codes/'
        }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  schema={pageSchema}
>
  <!-- Top Leaderboard Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <AdBanner slotType="leaderboard" slotId="outfit-top-leaderboard-en" locale={locale} />
  </div>

  <!-- Breadcrumbs & Hero -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4">
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4">
      <a href={`/${locale}/`} class="hover:text-indigo-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-pink-400 font-medium">Brookhaven Outfit Codes</span>
    </nav>

    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-pink-400 text-xs font-semibold">
        <span>👗</span>
        <span>Official Avatar IDs Catalog • 2026 Season</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        Brookhaven RP Outfit Codes: <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-rose-300 to-indigo-400">Clothes IDs 2026</span>
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-3xl leading-relaxed">
        Discover the highest-rated full outfit sets for Brookhaven RP. 1-click copy numeric Asset IDs for shirts, pants, SWAT military tactical suits, soft pastel aesthetics, anime cosplay, and hair combos for boys and girls.
      </p>
    </div>
  </div>

  <!-- Main Outfits App Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-12">
    
    <!-- Interactive Component -->
    <OutfitHub locale={locale} />

    <!-- In-Content Ad Banner -->
    <AdBanner slotType="banner" slotId="outfit-mid-banner-en" locale={locale} />

    <!-- Educational & High-Value SEO Content Section -->
    <article id="como-poner-codigos-brookhaven" class="bg-[#0b0f19] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-10 text-slate-300">
      
      <!-- Section 1: How to Redeem Step-by-Step -->
      <section class="space-y-4">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <span>🛠️</span> How to Enter Clothing Codes in Brookhaven RP (Full Guide)
        </h2>
        <p class="text-sm leading-relaxed">
          Equipping any clothing piece from our catalog inside Brookhaven RP takes only 10 seconds. Follow these simple steps on PC, Mobile, or Console:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-[#080c14] border border-white/5 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 font-bold flex items-center justify-center text-sm border border-pink-500/30">1</div>
            <h4 class="font-bold text-white text-sm">Open Avatar Editor</h4>
            <p class="text-xs text-slate-400 leading-relaxed">In-game, click the avatar icon with a pencil located along the right-hand menu bar.</p>
          </div>
          <div class="p-4 rounded-2xl bg-[#080c14] border border-white/5 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 font-bold flex items-center justify-center text-sm border border-pink-500/30">2</div>
            <h4 class="font-bold text-white text-sm">Select the "ID" Tab</h4>
            <p class="text-xs text-slate-400 leading-relaxed">In the clothing selector tabs, click the button marked "ID" to open the numeric input prompt.</p>
          </div>
          <div class="p-4 rounded-2xl bg-[#080c14] border border-white/5 space-y-2">
            <div class="w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 font-bold flex items-center justify-center text-sm border border-pink-500/30">3</div>
            <h4 class="font-bold text-white text-sm">Paste Code & Hit Enter</h4>
            <p class="text-xs text-slate-400 leading-relaxed">Paste the copied code and press Enter. Your avatar equips the fresh gear instantly!</p>
          </div>
        </div>
      </section>

      <!-- Section 2: Asset ID vs Product ID -->
      <section class="space-y-4 border-t border-white/5 pt-8">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <span>💡</span> Asset ID vs Product ID: Why Random Internet Codes Fail
        </h2>
        <p class="text-sm leading-relaxed">
          On Roblox, items have two distinct numeric identification formats:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
            <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">Asset ID (Works in Brookhaven)</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              The direct numeric pointer to the rendered visual texture asset. This is the only ID format accepted by Brookhaven RP's avatar system.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 space-y-2">
            <span class="text-xs font-mono font-bold text-rose-400 uppercase tracking-wider">Product ID (Web Store Only)</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              The catalog web page store purchase token. Pasting this number in Brookhaven RP yields an invalid asset error.
            </p>
          </div>
        </div>
        <p class="text-xs text-slate-400">
          On <strong>CodigosRoblox.org</strong>, every entry has been verified as a <strong>clean, functional Asset ID</strong> ready for instant application.
        </p>
      </section>

      <!-- Section 3: Author Review Box (E-E-A-T) -->
      <div class="p-5 rounded-2xl bg-pink-950/30 border border-pink-500/20 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-pink-600/30 border border-pink-400 flex items-center justify-center text-lg font-bold text-white">
            HM
          </div>
          <div>
            <span class="text-xs text-pink-400 font-mono uppercase tracking-wider block">Written & Verified by</span>
            <h4 class="text-sm font-bold text-white">Héctor Moreno • Community & Avatar Fashion Lead</h4>
            <p class="text-xs text-slate-400">Technically reviewed by Guillermo Beltrán and Jorge Villapún • Updated for 2026</p>
          </div>
        </div>
        <a 
          href={`/${locale}/about`}
          class="text-xs font-semibold px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-pink-300 border border-pink-500/30 transition-colors shrink-0"
        >
          Meet the Editorial Team →
        </a>
      </div>

    </article>

    <!-- FAQ Section -->
    <section class="bg-[#0b0f19] border border-white/10 rounded-3xl p-6 sm:p-10 space-y-6">
      <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
        <span>❓</span> Frequently Asked Questions About Brookhaven Clothes
      </h2>
      <div class="divide-y divide-white/5">
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">Do outfits save when leaving Brookhaven?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Brookhaven RP allows you to save up to 6 custom outfits in the game's outfit slots. When rejoining, you can reload your saved looks with 1 click.
          </p>
        </div>
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">Can I use these IDs in Berry Avenue or Livetopia?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Yes! Any Roblox experience featuring an ID-based avatar customizer (such as Berry Avenue, Da Hood, or Livetopia) accepts these exact same Asset IDs.
          </p>
        </div>
        <div class="py-4 space-y-1.5">
          <h3 class="text-sm sm:text-base font-bold text-white">Why doesn't my avatar change clothes?</h3>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
            Make sure to unequip any Roblox 3D Layered Clothing before using 2D ID codes, as 3D layers render on top of classic 2D shirts and pants.
          </p>
        </div>
      </div>
    </section>

    <!-- Cross-links to other tools -->
    <section class="grid grid-cols-1 sm:grid-cols-4 gap-4">
      <a 
        href={`/${locale}/music/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-indigo-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🎵</span>
        <h4 class="font-bold text-white group-hover:text-indigo-300 text-sm">Boombox Music IDs</h4>
        <p class="text-xs text-slate-400">Trending songs for Brookhaven.</p>
      </a>
      <a 
        href={`/${locale}/roblox-username-generator/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-purple-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🎲</span>
        <h4 class="font-bold text-white group-hover:text-purple-300 text-sm">Username Generator</h4>
        <p class="text-xs text-slate-400">Cool handles & clan tags.</p>
      </a>
      <a 
        href={`/${locale}/free-items/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-emerald-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🎁</span>
        <h4 class="font-bold text-white group-hover:text-emerald-300 text-sm">Free 0-Robux Items</h4>
        <p class="text-xs text-slate-400">Permanent inventory drops.</p>
      </a>
      <a 
        href={`/${locale}/roblox-error-codes/`}
        class="p-5 rounded-2xl bg-[#0b0f19] border border-white/10 hover:border-rose-500/40 transition-all group space-y-2 block"
      >
        <span class="text-2xl">🔧</span>
        <h4 class="font-bold text-white group-hover:text-rose-300 text-sm">Error Codes Hub</h4>
        <p class="text-xs text-slate-400">Instant fixes for 279 & 267.</p>
      </a>
    </section>

    <!-- Bottom Ad Slot -->
    <AdBanner slotType="rectangle" slotId="outfit-bottom-rect-en" locale={locale} />

  </main>
</Layout>
