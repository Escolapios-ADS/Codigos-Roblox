---
import { styleOptions, nameWordBanks } from '../data/name-presets';
import type { SupportedLocale } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
---

<div class="name-generator-wrapper relative overflow-hidden bg-[#0d1322] border border-white/10 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-8">
  
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/5 pb-6">
    <div class="space-y-1">
      <div class="inline-flex items-center gap-2 text-xs font-bold text-indigo-400 uppercase tracking-wider">
        <span>⚡</span>
        <span>{locale === 'es' ? 'Herramienta de Personalización Oficial' : 'Official Nickname Tool'}</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight">
        {locale === 'es' ? 'Generador de Nombres & Display Names' : 'Username & Display Name Generator'}
      </h2>
    </div>

    <!-- Generator primary action button -->
    <button
      type="button"
      id="gen-main-btn"
      class="px-5 py-3 rounded-2xl bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-bold text-xs shadow-lg shadow-indigo-600/30 border border-indigo-400/40 transition-all flex items-center gap-2 self-start sm:self-auto cursor-pointer"
    >
      <span class="text-base animate-spin-slow">🎲</span>
      <span>{locale === 'es' ? 'Generar Nuevos Nombres' : 'Generate New Names'}</span>
    </button>
  </div>

  <!-- Style Selection & Custom Keyword Input -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
    
    <!-- Style Selection Pills (2 columns) -->
    <div class="md:col-span-2 space-y-2">
      <label class="text-xs font-bold text-slate-300 uppercase tracking-wider">
        {locale === 'es' ? '1. Elige tu estilo de nombre' : '1. Choose your nickname style'}
      </label>
      <div class="flex flex-wrap items-center gap-2" id="style-selector-container">
        {styleOptions.map((opt, idx) => (
          <button
            type="button"
            class={`style-pill px-3.5 py-2 rounded-xl text-xs font-bold transition-all border ${
              idx === 0
                ? 'bg-indigo-600 text-white border-indigo-400 shadow-md shadow-indigo-600/30 active-style'
                : 'bg-white/5 hover:bg-white/10 text-slate-300 border-white/10'
            }`}
            data-style={opt.id}
          >
            <span>{opt.emoji}</span> {opt.label[locale]}
          </button>
        ))}
      </div>
    </div>

    <!-- Optional Custom Word Input -->
    <div class="space-y-2">
      <label for="custom-word-input" class="text-xs font-bold text-slate-300 uppercase tracking-wider">
        {locale === 'es' ? '2. Tu palabra o apodo (Opcional)' : '2. Custom word or root (Optional)'}
      </label>
      <div class="relative">
        <input
          type="text"
          id="custom-word-input"
          placeholder={locale === 'es' ? 'Ej. Alex, Luna, Dark...' : 'e.g. Alex, Luna, Dark...'}
          maxlength="12"
          class="w-full pl-9 pr-4 py-2.5 bg-black/40 border border-white/10 focus:border-indigo-500 rounded-xl text-xs text-white placeholder-slate-400 outline-none transition-all shadow-inner"
        />
        <span class="absolute left-3 top-2.5 text-slate-400 text-xs">✏️</span>
      </div>
    </div>

  </div>

  <!-- Generated Names Display Grid (12 items) -->
  <div class="space-y-4">
    <div class="flex items-center justify-between text-xs text-slate-400 border-t border-white/5 pt-4">
      <span class="font-medium">
        {locale === 'es' ? 'Sugerencias listas para copiar y usar en Roblox:' : 'Ready-to-use suggestions for Roblox:'}
      </span>
      <span class="text-[11px] font-mono text-indigo-400">
        12 {locale === 'es' ? 'ideas generadas' : 'ideas generated'}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" id="names-grid">
      <!-- Dynamically filled by JavaScript -->
    </div>
  </div>

  <!-- Saved Favorites Drawer / Storage Box -->
  <div class="bg-black/40 border border-white/10 rounded-2xl p-5 space-y-3" id="favorites-box">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="text-amber-400 text-sm">⭐</span>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">
          {locale === 'es' ? 'Tus Nombres Favoritos Guardados' : 'Your Saved Favorite Names'}
        </h4>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30" id="fav-count">
          0
        </span>
      </div>
      <button 
        type="button" 
        id="clear-favs-btn"
        class="text-[11px] text-slate-400 hover:text-rose-400 transition-colors"
      >
        {locale === 'es' ? 'Borrar guardados' : 'Clear saved'}
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-2" id="favorites-list">
      <span class="text-xs text-slate-400 italic" id="empty-fav-msg">
        {locale === 'es' ? 'Aún no has guardado ningún nombre. Haz clic en la estrella ⭐ de cualquier sugerencia.' : 'No favorites saved yet. Click the star ⭐ next to any suggestion.'}
      </span>
    </div>
  </div>

</div>

<script is:inline define:vars={{ banksJson: JSON.stringify(nameWordBanks), currentLocale: locale }}>
  document.addEventListener('DOMContentLoaded', () => {
    const banks = JSON.parse(banksJson);
    let currentStyle = 'pro';
    const stylePills = document.querySelectorAll('.style-pill');
    const customInput = document.getElementById('custom-word-input');
    const genBtn = document.getElementById('gen-main-btn');
    const namesGrid = document.getElementById('names-grid');
    const favoritesList = document.getElementById('favorites-list');
    const favCountEl = document.getElementById('fav-count');
    const emptyFavMsg = document.getElementById('empty-fav-msg');
    const clearFavsBtn = document.getElementById('clear-favs-btn');

    // Retrieve favorites from localStorage
    function getFavorites() {
      try {
        return JSON.parse(localStorage.getItem('roblox_favorite_names') || '[]');
      } catch(e) {
        return [];
      }
    }

    function saveFavorites(list) {
      localStorage.setItem('roblox_favorite_names', JSON.stringify(list));
      renderFavorites();
    }

    function renderFavorites() {
      const favs = getFavorites();
      if (favCountEl) favCountEl.textContent = String(favs.length);
      if (!favoritesList) return;

      if (favs.length === 0) {
        favoritesList.innerHTML = `
          <span class="text-xs text-slate-400 italic">
            ${currentLocale === 'es' ? 'Aún no has guardado ningún nombre. Haz clic en la estrella ⭐ de cualquier sugerencia.' : 'No favorites saved yet. Click the star ⭐ next to any suggestion.'}
          </span>
        `;
        return;
      }

      favoritesList.innerHTML = '';
      favs.forEach((favName) => {
        const pill = document.createElement('div');
        pill.className = 'group flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs font-mono text-amber-200';
        pill.innerHTML = `
          <span>${favName}</span>
          <button type="button" class="copy-fav-btn text-indigo-400 hover:text-white" title="Copiar">📋</button>
          <button type="button" class="del-fav-btn text-slate-400 hover:text-rose-400" title="Eliminar">✕</button>
        `;

        pill.querySelector('.copy-fav-btn').addEventListener('click', () => {
          if (window.copyCodeToClipboard) window.copyCodeToClipboard(favName);
        });

        pill.querySelector('.del-fav-btn').addEventListener('click', () => {
          const updated = getFavorites().filter(n => n !== favName);
          saveFavorites(updated);
        });

        favoritesList.appendChild(pill);
      });
    }

    if (clearFavsBtn) {
      clearFavsBtn.addEventListener('click', () => {
        saveFavorites([]);
      });
    }

    function randomPick(arr) {
      return arr[Math.floor(Math.random() * arr.length)];
    }

    function generateNames() {
      const customWord = (customInput ? customInput.value : '').trim().replace(/[^a-zA-Z0-9]/g, '');
      const results = [];
      const used = new Set();
      const favs = getFavorites();

      while (results.length < 12) {
        let name = '';
        const num = Math.floor(Math.random() * 90) + 10;

        if (currentStyle === 'clans') {
          const tag = randomPick(banks.clans.tags);
          const core = customWord || randomPick(banks.clans.cores);
          name = `${tag} ${core}`;
        } else if (currentStyle === 'aesthetic') {
          const prefix = customWord.toLowerCase() || randomPick(banks.aesthetic.prefixes);
          const suffix = randomPick(banks.aesthetic.suffixes);
          const connector = randomPick(banks.aesthetic.connectors);
          name = `${prefix}${connector}${suffix}`;
        } else {
          const bank = banks[currentStyle] || banks.pro;
          const prefix = customWord || randomPick(bank.prefixes);
          const suffix = randomPick(bank.suffixes);
          const connector = randomPick(bank.connectors);
          const hasNum = Math.random() > 0.6;
          name = `${prefix}${connector}${suffix}${hasNum ? num : ''}`;
        }

        if (!used.has(name)) {
          used.add(name);
          results.push(name);
        }
      }

      renderGenerated(results);
    }

    function renderGenerated(names) {
      if (!namesGrid) return;
      namesGrid.innerHTML = '';
      const favs = getFavorites();

      names.forEach((name) => {
        const isFav = favs.includes(name);
        const card = document.createElement('div');
        card.className = 'group flex items-center justify-between p-3.5 rounded-2xl bg-[#080c14]/90 border border-white/5 hover:border-indigo-500/30 transition-all shadow-sm';
        card.innerHTML = `
          <div class="flex items-center gap-2.5 overflow-hidden">
            <button 
              type="button" 
              class="fav-toggle-btn text-base opacity-40 hover:opacity-100 transition-opacity ${isFav ? 'opacity-100 text-amber-400' : 'text-slate-400'}"
              title="Guardar en favoritos"
            >
              ⭐
            </button>
            <span class="font-mono text-sm font-bold text-white group-hover:text-indigo-200 transition-colors truncate">
              ${name}
            </span>
          </div>

          <button
            type="button"
            class="copy-name-btn px-3 py-1.5 rounded-xl bg-white/5 hover:bg-indigo-600 text-slate-300 hover:text-white border border-white/10 hover:border-indigo-400 text-xs font-semibold transition-all shrink-0 flex items-center gap-1"
          >
            <span>📋</span>
            <span>${currentLocale === 'es' ? 'Copiar' : 'Copy'}</span>
          </button>
        `;

        // Copy listener
        card.querySelector('.copy-name-btn').addEventListener('click', function() {
          if (window.copyCodeToClipboard) window.copyCodeToClipboard(name, this);
        });

        // Favorite listener
        card.querySelector('.fav-toggle-btn').addEventListener('click', function() {
          let currentFavs = getFavorites();
          if (currentFavs.includes(name)) {
            currentFavs = currentFavs.filter(n => n !== name);
            this.classList.remove('opacity-100', 'text-amber-400');
            this.classList.add('opacity-40', 'text-slate-400');
          } else {
            currentFavs.push(name);
            this.classList.add('opacity-100', 'text-amber-400');
            this.classList.remove('opacity-40', 'text-slate-400');
          }
          saveFavorites(currentFavs);
        });

        namesGrid.appendChild(card);
      });
    }

    stylePills.forEach((pill) => {
      pill.addEventListener('click', () => {
        stylePills.forEach((p) => {
          p.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-style');
          p.classList.add('bg-white/5', 'text-slate-300', 'border-white/10');
        });

        pill.classList.remove('bg-white/5', 'text-slate-300', 'border-white/10');
        pill.classList.add('bg-indigo-600', 'text-white', 'border-indigo-400', 'shadow-md', 'shadow-indigo-600/30', 'active-style');

        currentStyle = pill.getAttribute('data-style') || 'pro';
        generateNames();
      });
    });

    if (customInput) {
      customInput.addEventListener('input', () => {
        generateNames();
      });
    }

    if (genBtn) {
      genBtn.addEventListener('click', () => {
        if (window.playRewardSound) window.playRewardSound();
        generateNames();
      });
    }

    // Initial render
    renderFavorites();
    generateNames();
  });
</script>
