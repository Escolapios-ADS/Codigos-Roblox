---
import type { SupportedLocale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
  totalCodes: number;
  totalGames: number;
}

const { locale, totalCodes, totalGames } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-white/5 bg-radial-[at_50%_0%] from-indigo-950/40 via-[#080c14] to-[#080c14]">
  <!-- Decorative ambient glow elements -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-indigo-600/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/4 right-10 w-[350px] h-[250px] bg-cyan-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
    
    <!-- Live status pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/30 text-indigo-300 text-xs font-semibold shadow-inner">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span>{t.hero.liveBadge}</span>
      <span class="text-indigo-400/50">|</span>
      <span class="text-slate-300 font-mono">2026</span>
    </div>

    <!-- Main Heading -->
    <div class="space-y-4">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-white leading-tight">
        <span class="bg-gradient-to-r from-indigo-400 via-violet-300 to-cyan-300 bg-clip-text text-transparent">
          {t.hero.titleHighlight}
        </span>
        <br />
        <span class="text-slate-100">{t.hero.titleEnd}</span>
      </h1>
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
        {t.hero.subtitle}
      </p>
    </div>

    <!-- Instant Search Bar with Live Filter Input -->
    <div class="max-w-2xl mx-auto relative group">
      <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-cyan-500 rounded-2xl blur opacity-25 group-hover:opacity-45 transition duration-300"></div>
      <div class="relative flex items-center bg-[#0d1322] border border-white/15 rounded-2xl p-2 shadow-2xl">
        <div class="pl-3 pr-2 text-slate-400">
          <svg class="w-5 h-5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <input 
          type="search"
          id="game-search-input"
          placeholder={t.hero.searchPlaceholder}
          class="w-full bg-transparent border-none text-white text-sm sm:text-base placeholder-slate-400 focus:outline-none focus:ring-0 py-2"
          autocomplete="off"
        />
        <div class="pr-2 hidden sm:flex items-center gap-1 text-[11px] text-slate-400 font-mono bg-white/5 border border-white/10 px-2 py-1 rounded-md">
          <span>Ctrl</span>
          <span>+</span>
          <span>K</span>
        </div>
      </div>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 pt-2" id="category-filters">
      <button 
        type="button" 
        data-category="all"
        class="category-btn active px-4 py-1.5 rounded-full text-xs font-semibold bg-indigo-600 text-white border border-indigo-400/40 shadow-sm transition-all"
      >
        {t.categories.all}
      </button>
      <button 
        type="button" 
        data-category="anime"
        class="category-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all"
      >
        {t.categories.anime}
      </button>
      <button 
        type="button" 
        data-category="action"
        class="category-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all"
      >
        {t.categories.action}
      </button>
      <button 
        type="button" 
        data-category="fashion"
        class="category-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all"
      >
        {t.categories.fashion}
      </button>
      <button 
        type="button" 
        data-category="promo"
        class="category-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all"
      >
        {t.categories.promo}
      </button>
      <button 
        type="button" 
        data-category="simulator"
        class="category-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/10 transition-all"
      >
        {t.categories.simulator}
      </button>
    </div>

    <!-- Live Performance Metric Cards -->
    <div class="grid grid-cols-3 gap-2 sm:gap-3 max-w-xl mx-auto pt-6 text-center">
      <div class="bg-white/[0.03] border border-white/10 rounded-xl p-2.5 sm:p-3.5 backdrop-blur-sm">
        <div class="text-xl sm:text-3xl font-black text-white font-mono">{totalCodes}+</div>
        <div class="text-[10px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1">
          {t.hero.statCodes}
        </div>
      </div>
      <div class="bg-white/[0.03] border border-white/10 rounded-xl p-2.5 sm:p-3.5 backdrop-blur-sm">
        <div class="text-xl sm:text-3xl font-black text-indigo-400 font-mono">{totalGames}</div>
        <div class="text-[10px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1">
          {t.hero.statGames}
        </div>
      </div>
      <div class="bg-white/[0.03] border border-white/10 rounded-xl p-2.5 sm:p-3.5 backdrop-blur-sm">
        <div class="text-xl sm:text-3xl font-black text-emerald-400 font-mono">100%</div>
        <div class="text-[10px] sm:text-xs text-slate-400 uppercase tracking-wider font-semibold mt-1">
          {t.hero.statAccuracy}
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Vanilla JS for instant interactive filter on the client -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('game-search-input');
    const filterButtons = document.querySelectorAll('.category-btn');
    const gameCards = document.querySelectorAll('.game-card-item');
    const noResults = document.getElementById('no-results-message');

    let currentCategory = 'all';
    let currentQuery = '';

    function filterCards() {
      let visibleCount = 0;
      gameCards.forEach((card) => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const category = card.getAttribute('data-category') || '';
        
        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesSearch = title.includes(currentQuery);

        if (matchesCategory && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        filterCards();
      });

      // Keyboard shortcut Ctrl+K
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-indigo-600', 'text-white', 'border-indigo-400/40');
          b.classList.add('bg-white/5', 'text-slate-300', 'border-white/10');
        });
        btn.classList.add('bg-indigo-600', 'text-white', 'border-indigo-400/40');
        btn.classList.remove('bg-white/5', 'text-slate-300', 'border-white/10');

        currentCategory = btn.getAttribute('data-category') || 'all';
        filterCards();
      });
    });
  });
</script>
