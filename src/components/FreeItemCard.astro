---
import type { FreeItem } from '../types/free-item';
import type { SupportedLocale } from '../i18n/translations';

interface Props {
  item: FreeItem;
  locale: SupportedLocale;
}

const { item, locale } = Astro.props;
---

<div 
  class="free-item-card group relative overflow-hidden bg-[#0d1322]/80 hover:bg-[#11192e] border border-white/5 hover:border-indigo-500/30 rounded-2xl p-5 transition-all duration-300 shadow-lg hover:shadow-indigo-500/10 flex flex-col justify-between gap-4"
  data-title={item.title.toLowerCase()}
  data-category={item.category}
  data-method={item.method}
>
  <!-- Top: Category, Badge & Price Tag -->
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2">
      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-indigo-300">
        {item.categoryLabel[locale]}
      </span>
      <div class="flex items-center gap-1.5">
        {item.badge && (
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300">
            {item.badge[locale]}
          </span>
        )}
        <span class="text-[10px] font-mono font-black uppercase px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
          0 ROBUX
        </span>
      </div>
    </div>

    <!-- Icon & Title -->
    <div class="flex items-start gap-3.5">
      <div class="w-12 h-12 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-3xl shrink-0 group-hover:scale-105 transition-transform">
        {item.emoji}
      </div>
      <div>
        <h3 class="text-base font-bold text-white group-hover:text-indigo-200 transition-colors line-clamp-1">
          {item.title}
        </h3>
        <p class="text-[11px] text-cyan-400 font-medium mt-0.5 flex items-center gap-1">
          <span>🏷️</span>
          <span>{item.methodLabel[locale]}</span>
        </p>
      </div>
    </div>

    <!-- Step by step instruction -->
    <p class="text-xs text-slate-300 leading-relaxed bg-white/[0.01] border border-white/5 rounded-xl p-3">
      {item.instructions[locale]}
    </p>
  </div>

  <!-- Bottom CTA: Direct official Roblox link -->
  <div class="pt-3 border-t border-white/5 flex items-center justify-between gap-3">
    <span class="text-[10px] text-slate-400 font-mono">
      {locale === 'es' ? '100% Oficial de Roblox' : '100% Official Roblox Drop'}
    </span>

    <a
      href={item.robloxUrl}
      target="_blank"
      rel="noopener noreferrer"
      onclick="if (window.playRewardSound) window.playRewardSound()"
      class="shrink-0 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-xs shadow-lg shadow-emerald-600/20 border border-emerald-400/30 transition-all flex items-center gap-1.5 focus:outline-none"
    >
      <span>{locale === 'es' ? 'Reclamar Gratis' : 'Claim for Free'}</span>
      <svg class="w-3.5 h-3.5 text-emerald-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>
  </div>
</div>
