---
import type { SupportedLocale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
  currentSlug?: string;
}

const { locale, currentSlug } = Astro.props;
const t = getTranslations(locale);

// Compute target alternate URL for the other language
const otherLocale: SupportedLocale = locale === 'es' ? 'en' : 'es';
const pathname = Astro.url.pathname;
let targetAlternateUrl = `/${otherLocale}/`;

if (currentSlug) {
  targetAlternateUrl = `/${otherLocale}/juego/${currentSlug}`;
} else if (pathname.includes('/musica') || pathname.includes('/music')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/musica/' : '/en/music/';
} else if (pathname.includes('/calculadora-tradeos-blox-fruits') || pathname.includes('/blox-fruits-trade-calculator')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/calculadora-tradeos-blox-fruits/' : '/en/blox-fruits-trade-calculator/';
} else if (pathname.includes('/calculadora-robux-dinero-real') || pathname.includes('/robux-to-money-calculator')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/calculadora-robux-dinero-real/' : '/en/robux-to-money-calculator/';
} else if (pathname.includes('/objetos-gratis') || pathname.includes('/free-items')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/objetos-gratis/' : '/en/free-items/';
} else if (pathname.includes('/generador-nombres-roblox') || pathname.includes('/roblox-username-generator')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/generador-nombres-roblox/' : '/en/roblox-username-generator/';
} else if (pathname.includes('/generador-tarjeta-roblox') || pathname.includes('/roblox-profile-card')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/generador-tarjeta-roblox/' : '/en/roblox-profile-card/';
} else if (pathname.includes('/errores-roblox') || pathname.includes('/roblox-error-codes')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/errores-roblox/' : '/en/roblox-error-codes/';
} else if (pathname.includes('/codigos-ropa-brookhaven') || pathname.includes('/brookhaven-outfit-codes')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/codigos-ropa-brookhaven/' : '/en/brookhaven-outfit-codes/';
} else if (pathname.includes('/quiz-frutas-blox-fruits') || pathname.includes('/blox-fruits-quiz')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/quiz-frutas-blox-fruits/' : '/en/blox-fruits-quiz/';
} else if (pathname.includes('/tier-list-blox-fruits') || pathname.includes('/blox-fruits-tier-list')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/tier-list-blox-fruits/' : '/en/blox-fruits-tier-list/';
} else if (pathname.includes('/optimizar-roblox-fps-lag') || pathname.includes('/roblox-fps-unlocker-lag-fix')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/optimizar-roblox-fps-lag/' : '/en/roblox-fps-unlocker-lag-fix/';
} else if (pathname.includes('/alertas-codigos-roblox') || pathname.includes('/roblox-code-alerts')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/alertas-codigos-roblox/' : '/en/roblox-code-alerts/';
} else if (pathname.includes('/guias')) {
  targetAlternateUrl = `/${otherLocale}/guias/`;
} else if (pathname.includes('/sobre-nosotros') || pathname.includes('/about')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/sobre-nosotros/' : '/en/about/';
} else if (pathname.includes('/contacto') || pathname.includes('/contact')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/contacto/' : '/en/contact/';
} else if (pathname.includes('/privacidad') || pathname.includes('/privacy')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/privacidad/' : '/en/privacy/';
} else if (pathname.includes('/terminos') || pathname.includes('/terms')) {
  targetAlternateUrl = otherLocale === 'es' ? '/es/terminos/' : '/en/terms/';
}
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-[#080c14]/90 border-b border-white/10 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo -->
      <a href={`/${locale}/`} class="flex items-center gap-3 group shrink-0">
        <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-violet-600 to-cyan-400 p-[1px] shadow-lg shadow-indigo-500/20 group-hover:shadow-indigo-500/40 transition-all duration-300">
          <div class="w-full h-full bg-[#0b0f19] rounded-[11px] flex items-center justify-center">
            <!-- Roblox 3D cube icon -->
            <svg class="w-5 h-5 text-cyan-400 transform group-hover:rotate-12 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" role="img">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-black tracking-tight text-white flex items-center gap-1.5">
            {t.nav.brand}
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">2026</span>
          </span>
          <span class="text-[10px] text-slate-400 tracking-wider uppercase font-medium -mt-1 hidden sm:block">
            {t.nav.brandSubtitle}
          </span>
        </div>
      </a>

      <!-- Desktop Streamlined Navigation Bar (Hidden on Mobile) -->
      <nav class="hidden lg:flex items-center gap-1 text-xs xl:text-sm font-medium">
        
        <!-- 1. Home -->
        <a 
          href={`/${locale}/`}
          class="px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
        >
          {t.nav.home}
        </a>

        <!-- 2. Games -->
        <a 
          href={`/${locale}/#juegos`}
          class="px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-1"
        >
          <span>🎮</span>
          <span>{t.nav.games}</span>
        </a>

        <!-- 3. Free Drops Dropdown -->
        <div class="relative group/dropdown">
          <button 
            type="button"
            class="px-3 py-2 rounded-xl text-slate-300 group-hover/dropdown:text-white group-hover/dropdown:bg-white/5 transition-colors flex items-center gap-1.5 cursor-pointer"
          >
            <span>🎁</span>
            <span>{t.nav.freeMenu}</span>
            <span class="text-[10px] text-slate-400 group-hover/dropdown:rotate-180 transition-transform duration-200">▼</span>
          </button>

          <div class="absolute left-0 top-full pt-2 hidden group-hover/dropdown:block z-50 w-64 animate-fade-in">
            <div class="bg-[#0b0f19] border border-white/10 rounded-2xl p-2 shadow-2xl shadow-black/80 backdrop-blur-2xl space-y-1">
              <a 
                href={`/${locale}/${locale === 'es' ? 'objetos-gratis/' : 'free-items/'}`}
                class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
              >
                <span class="text-xl p-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">🎁</span>
                <div>
                  <span class="font-bold text-white group-hover/item:text-emerald-300 text-xs block">
                    {locale === 'es' ? 'Ropa & Objetos Gratis' : 'Free Clothes & Items'}
                  </span>
                  <span class="text-[10px] text-slate-400 block">{locale === 'es' ? 'Drops 0 Robux permanentes' : '0-Robux permanent drops'}</span>
                </div>
              </a>

              <a 
                href={`/${locale}/juego/roblox-promo-codes`}
                class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item"
              >
                <span class="text-xl p-1.5 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">✨</span>
                <div>
                  <span class="font-bold text-white group-hover/item:text-cyan-300 text-xs block">
                    {locale === 'es' ? 'Promo Codes Globales' : 'Global Promo Codes'}
                  </span>
                  <span class="text-[10px] text-slate-400 block">{locale === 'es' ? 'Recompensas oficiales activas' : 'Working official rewards'}</span>
                </div>
              </a>

              <a 
                href={`/${locale}/#como-canjear`}
                class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-white/5 transition-colors group/item border-t border-white/5 pt-2"
              >
                <span class="text-base p-1 text-slate-400">📖</span>
                <div>
                  <span class="font-medium text-slate-300 group-hover/item:text-white text-xs block">
                    {locale === 'es' ? '¿Cómo Canjear Códigos?' : 'How to Redeem Codes?'}
                  </span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- 4. VIP Tools Mega Menu Dropdown -->
        <div class="relative group/megamenu">
          <button 
            type="button"
            class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-indigo-500/10 via-purple-500/10 to-pink-500/10 hover:from-indigo-500/20 hover:to-pink-500/20 text-indigo-300 hover:text-white border border-indigo-500/20 hover:border-indigo-400/40 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm"
          >
            <span>🛠️</span>
            <span class="font-bold">{t.nav.toolsMenu}</span>
            <span class="text-[9px] px-1.5 py-0.5 rounded-full bg-indigo-500/30 text-indigo-200 uppercase font-mono font-bold">10</span>
            <span class="text-[10px] text-indigo-400 group-hover/megamenu:rotate-180 transition-transform duration-200">▼</span>
          </button>

          <!-- Luxurious Mega Menu Panel -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 hidden group-hover/megamenu:block z-50 w-[740px] animate-fade-in">
            <div class="bg-[#0b0f19]/95 border border-white/10 rounded-3xl p-5 shadow-2xl shadow-black/90 backdrop-blur-2xl grid grid-cols-3 gap-4">
              
              <!-- Column 1: Blox Fruits & Economy -->
              <div class="space-y-2">
                <div class="px-2 pb-1 border-b border-white/5 flex items-center gap-1.5 text-[10px] font-mono font-bold uppercase tracking-wider text-amber-400">
                  <span>⚔️</span>
                  <span>{locale === 'es' ? 'Economía & Blox Fruits' : 'Economy & Blox Fruits'}</span>
                </div>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'tier-list-blox-fruits/' : 'blox-fruits-tier-list/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-orange-500/10 border border-transparent hover:border-orange-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-orange-500/10 text-orange-400 shrink-0">🏆</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-orange-300 text-xs block">
                      {locale === 'es' ? 'Tier List Maker' : 'Tier List Maker'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Crea y exporta en PNG' : 'Build & export PNG'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'calculadora-robux-dinero-real/' : 'robux-to-money-calculator/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-emerald-500/10 border border-transparent hover:border-emerald-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-emerald-500/10 text-emerald-400 shrink-0">💰</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-emerald-300 text-xs block">
                      {locale === 'es' ? 'Robux a Dinero Real' : 'Robux to Cash & DevEx'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'DevEx, EUR, USD e impuesto 30%' : 'DevEx, USD, EUR & 30% tax'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'calculadora-tradeos-blox-fruits/' : 'blox-fruits-trade-calculator/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-amber-500/10 border border-transparent hover:border-amber-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-amber-500/10 text-amber-400 shrink-0">⚖️</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-amber-300 text-xs block">
                      {locale === 'es' ? 'Calculadora Tradeos' : 'Trade Calculator'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Valores W/F/L en vivo' : 'Live W/F/L fruit values'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'quiz-frutas-blox-fruits/' : 'blox-fruits-quiz/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-purple-500/10 border border-transparent hover:border-purple-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-purple-500/10 text-purple-400 shrink-0">🧠</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-purple-300 text-xs block">
                      {locale === 'es' ? 'Quiz de Frutas' : 'Fruit Quiz'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Descubre tu build ideal' : 'Find your fruit build'}</span>
                  </div>
                </a>
              </div>

              <!-- Column 2: Avatar & Style -->
              <div class="space-y-2">
                <div class="px-2 pb-1 border-b border-white/5 flex items-center gap-1.5 text-[10px] font-mono font-bold uppercase tracking-wider text-pink-400">
                  <span>👗</span>
                  <span>{locale === 'es' ? 'Avatar & Estilo' : 'Avatar & Style'}</span>
                </div>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'generador-tarjeta-roblox/' : 'roblox-profile-card/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-cyan-500/10 border border-transparent hover:border-cyan-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-cyan-500/10 text-cyan-400 shrink-0">💳</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-cyan-300 text-xs block">
                      {locale === 'es' ? 'Tarjeta Gamer ID' : 'Gamer ID Card'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Avatar 3D y badge Discord' : '3D avatar & Discord badge'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'codigos-ropa-brookhaven/' : 'brookhaven-outfit-codes/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-pink-500/10 border border-transparent hover:border-pink-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-pink-500/10 text-pink-400 shrink-0">👗</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-pink-300 text-xs block">
                      {locale === 'es' ? 'Ropa Brookhaven' : 'Brookhaven Outfits'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Outfits e IDs de ropa' : 'Clothes & outfit IDs'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'generador-nombres-roblox/' : 'roblox-username-generator/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-indigo-500/10 border border-transparent hover:border-indigo-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-indigo-500/10 text-indigo-400 shrink-0">🎲</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-indigo-300 text-xs block">
                      {locale === 'es' ? 'Generador Nombres' : 'Name Generator'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Apodos y tags de clanes' : 'Handles & clan tags'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'musica/' : 'music/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-violet-500/10 border border-transparent hover:border-violet-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-violet-500/10 text-violet-400 shrink-0">🎵</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-violet-300 text-xs block">
                      {locale === 'es' ? 'Música Boombox' : 'Boombox IDs'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Canciones verificadas' : 'Working song codes'}</span>
                  </div>
                </a>
              </div>

              <!-- Column 3: Performance & Support -->
              <div class="space-y-2">
                <div class="px-2 pb-1 border-b border-white/5 flex items-center gap-1.5 text-[10px] font-mono font-bold uppercase tracking-wider text-cyan-400">
                  <span>⚡</span>
                  <span>{locale === 'es' ? 'Rendimiento & Soporte' : 'Performance & Fixes'}</span>
                </div>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'optimizar-roblox-fps-lag/' : 'roblox-fps-unlocker-lag-fix/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-cyan-500/10 border border-transparent hover:border-cyan-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-cyan-500/10 text-cyan-400 shrink-0">⚡</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-cyan-300 text-xs block">
                      {locale === 'es' ? 'Optimizar FPS & Lag' : 'FPS Unlocker & Lag'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? '144Hz y baja de ping' : '144Hz FastFlags & ping'}</span>
                  </div>
                </a>

                <a 
                  href={`/${locale}/${locale === 'es' ? 'errores-roblox/' : 'roblox-error-codes/'}`}
                  class="flex items-start gap-2.5 p-2 rounded-2xl hover:bg-rose-500/10 border border-transparent hover:border-rose-500/20 transition-all group/item"
                >
                  <span class="text-xl p-1.5 rounded-xl bg-rose-500/10 text-rose-400 shrink-0">🔧</span>
                  <div>
                    <span class="font-bold text-white group-hover/item:text-rose-300 text-xs block">
                      {locale === 'es' ? 'Códigos de Error' : 'Error Codes Hub'}
                    </span>
                    <span class="text-[10px] text-slate-400 line-clamp-1">{locale === 'es' ? 'Solución a 279, 267...' : 'Fix 279, 267, 524...'}</span>
                  </div>
                </a>
              </div>

            </div>
          </div>
        </div>

        <!-- 5. Guides -->
        <a 
          href={`/${locale}/guias/`}
          class="px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition-colors"
        >
          {t.nav.guides}
        </a>

        <!-- 6. VIP Alerts Button with Pulse -->
        <a 
          href={`/${locale}/${locale === 'es' ? 'alertas-codigos-roblox/' : 'roblox-code-alerts/'}`}
          class="px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 hover:text-white transition-all flex items-center gap-1.5 font-bold shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>{t.nav.vipAlertsBtn}</span>
        </a>

      </nav>

      <!-- Right controls: Language Switcher & Mobile Menu Trigger -->
      <div class="flex items-center gap-2.5">
        
        <!-- Language Switcher Pill -->
        <a
          href={targetAlternateUrl}
          aria-label={t.nav.langAria}
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-slate-200 hover:text-white transition-all shadow-sm"
          title={`Switch language / Cambiar idioma`}
        >
          <span class="text-sm">{locale === 'es' ? '🇪🇸' : '🇬🇧'}</span>
          <span class="uppercase font-mono text-[11px] tracking-wider">{locale}</span>
          <span class="text-slate-500">⇄</span>
          <span class="text-indigo-400 uppercase font-mono text-[11px] tracking-wider">{otherLocale}</span>
        </a>

        <!-- Mobile Menu Hamburger Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Abrir menú de navegación"
          class="lg:hidden p-2.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white focus:outline-none transition-colors cursor-pointer"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

      </div>

    </div>
  </div>

  <!-- Mobile Gaming Drawer (Full Screen / Modal Style for Gen Z / Mobile UX) -->
  <div 
    id="mobile-menu" 
    class="hidden lg:hidden border-t border-white/10 bg-[#080c14]/98 backdrop-blur-2xl max-h-[85vh] overflow-y-auto px-4 py-5 space-y-6 animate-fade-in shadow-2xl"
  >
    
    <!-- Quick Action Pills Row -->
    <div class="grid grid-cols-3 gap-2">
      <a 
        href={`/${locale}/#juegos`}
        class="mobile-quick-link p-3 rounded-2xl bg-indigo-600/20 border border-indigo-500/30 text-center space-y-1 block"
      >
        <span class="text-xl block">🎮</span>
        <span class="text-[11px] font-bold text-white block truncate">{t.nav.games}</span>
      </a>

      <a 
        href={`/${locale}/${locale === 'es' ? 'objetos-gratis/' : 'free-items/'}`}
        class="mobile-quick-link p-3 rounded-2xl bg-emerald-600/20 border border-emerald-500/30 text-center space-y-1 block"
      >
        <span class="text-xl block">🎁</span>
        <span class="text-[11px] font-bold text-white block truncate">{t.nav.freeMenu}</span>
