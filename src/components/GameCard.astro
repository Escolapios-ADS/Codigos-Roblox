---
import type { GameItem } from '../types/game';
import type { SupportedLocale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';

interface Props {
  game: GameItem;
  locale: SupportedLocale;
}

const { game, locale } = Astro.props;
const t = getTranslations(locale);
const activeCount = game.activeCodes.length;
---

<article 
  class="game-card-item group relative bg-[#0d1322] border border-white/10 hover:border-indigo-500/50 rounded-2xl p-5 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10 flex flex-col justify-between"
  data-title={game.title.toLowerCase()}
  data-category={game.category}
>
  <!-- Card Header & Badge -->
  <div>
    <div class="flex items-start justify-between gap-3 mb-4">
      <!-- Icon with game emoji & gradient -->
      <div class={`w-14 h-14 rounded-2xl bg-gradient-to-tr ${game.iconGradient} p-[2px] shadow-lg shadow-black/40 group-hover:scale-105 transition-transform duration-300`}>
        <div class="w-full h-full bg-[#0b0f19] rounded-[14px] flex items-center justify-center text-2xl">
          {game.emoji}
        </div>
      </div>

      <!-- Badge (Trending / Top / Viral) -->
      {game.badge && (
        <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-white/5 border border-white/10 text-slate-200 group-hover:border-indigo-500/30 transition-colors">
          {game.badge[locale]}
        </span>
      )}
    </div>

    <!-- Title and Developer -->
    <div class="space-y-1 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">
          {game.categoryLabel[locale]}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-xs text-slate-400 font-medium">
          {game.developer}
        </span>
      </div>
      <h3 class="text-xl font-bold text-white group-hover:text-indigo-300 transition-colors">
        <a href={`/${locale}/juego/${game.slug}`} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {game.title}
        </a>
      </h3>
    </div>

    <!-- Tagline -->
    <p class="text-xs leading-relaxed text-slate-300 line-clamp-2 mb-4">
      {game.tagline[locale]}
    </p>
  </div>

  <!-- Card Footer & Metrics -->
  <div class="pt-4 border-t border-white/5 flex items-center justify-between">
    <!-- Active Codes Counter Pill -->
    <div class="flex items-center gap-1.5 text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-lg">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{activeCount} {t.gameCard.activeCount}</span>
    </div>

    <!-- View Codes Arrow Button -->
    <div class="flex items-center gap-1 text-xs font-semibold text-indigo-400 group-hover:text-cyan-300 transition-colors">
      <span>{t.gameCard.viewCodes}</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </div>
  </div>
</article>
