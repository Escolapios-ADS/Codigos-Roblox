---
import type { SupportedLocale } from '../i18n/translations';

interface Props {
  slotType: 'horizontal' | 'rectangle' | 'in-feed';
  locale?: SupportedLocale;
  className?: string;
}

const { slotType, locale = 'es', className = '' } = Astro.props;

const dimensions = {
  horizontal: 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
  rectangle: 'min-h-[250px] max-w-sm',
  'in-feed': 'min-h-[90px] w-full',
};
---

<div class={`ad-container my-8 mx-auto text-center ${dimensions[slotType]} ${className}`}>
  <!-- Mandatory AdSense disclosure label -->
  <div class="text-[10px] uppercase font-mono tracking-widest text-slate-400 mb-1.5 flex items-center justify-center gap-1.5">
    <span>—</span>
    <span>{locale === 'es' ? 'Publicidad' : 'Advertisement'}</span>
    <span>—</span>
  </div>

  <!-- Ad Slot Box (Prepared for AdSense / Mediavine code) -->
  <div class="w-full h-full bg-[#0b101d]/60 border border-dashed border-white/10 rounded-2xl flex flex-col items-center justify-center p-4 text-slate-400 transition-colors hover:border-indigo-500/20">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-400">
      <span class="w-2 h-2 rounded-full bg-slate-600"></span>
      <span>{locale === 'es' ? 'Espacio Publicitario Reservado' : 'Reserved Advertisement Slot'}</span>
    </div>
    <span class="text-[11px] text-slate-400 mt-1">
      {locale === 'es' ? 'Google AdSense / Anuncios Verificados' : 'Google AdSense / Verified Ads'}
    </span>
  </div>
</div>
