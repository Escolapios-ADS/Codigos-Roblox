---
import type { SupportedLocale } from '../i18n/translations';

interface Props {
  slotType: 'horizontal' | 'rectangle' | 'in-feed' | 'leaderboard' | 'billboard';
  locale?: SupportedLocale;
  className?: string;
  slotId?: string;
}

const { slotType, locale = 'es', className = '', slotId } = Astro.props;

const dimensions = {
  leaderboard: 'min-h-[90px] sm:min-h-[100px] max-w-5xl',
  billboard: 'min-h-[160px] sm:min-h-[250px] max-w-5xl',
  horizontal: 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
  rectangle: 'min-h-[250px] w-full max-w-[300px] sm:max-w-[336px]',
  'in-feed': 'min-h-[90px] sm:min-h-[100px] w-full',
};

const slotTitles = {
  leaderboard: 'LEADERBOARD 728x90 / 970x90',
  billboard: 'BILLBOARD 970x250',
  horizontal: 'BANNER HORIZONTAL RESPONSIVO',
  rectangle: 'RECTÁNGULO MEDIO 300x250',
  'in-feed': 'IN-FEED NATIVO AUTOMÁTICO',
};
---

<div class={`ad-container my-6 mx-auto text-center ${dimensions[slotType]} ${className}`}>
  <!-- Mandatory AdSense disclosure label -->
  <div class="text-[9px] uppercase font-mono tracking-widest text-slate-400 mb-1 flex items-center justify-center gap-1.5">
    <span>—</span>
    <span>{locale === 'es' ? 'Publicidad' : 'Advertisement'}</span>
    {slotId && <span class="text-slate-400 font-mono">({slotId})</span>}
    <span>—</span>
  </div>

  <!-- Ad Slot Box (Prepared for Google AdSense / Mediavine / Ezoic) -->
  <div class="w-full h-full bg-[#0b101d]/75 border border-dashed border-white/10 hover:border-indigo-500/30 rounded-2xl flex flex-col items-center justify-center p-3.5 text-slate-400 transition-colors shadow-sm">
    <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
      <span class="w-2 h-2 rounded-full bg-emerald-500/80 animate-pulse"></span>
      <span class="font-mono text-[11px] text-indigo-300">{slotTitles[slotType]}</span>
    </div>
    <span class="text-[10px] text-slate-400 mt-1">
      {locale === 'es' ? 'Espacio Reservado para Google AdSense' : 'Reserved for Google AdSense Ads'}
    </span>
  </div>
</div>
