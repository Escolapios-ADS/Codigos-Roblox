---
import type { SupportedLocale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';
import { gamesData } from '../data/games';
import { socialConfig } from '../config/social';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const currentYear = 2026;
---

<footer class="bg-[#05080e] border-t border-white/10 pt-16 pb-12 text-slate-400 text-sm content-visibility-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Mission -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-500 to-cyan-400 p-[1px]">
            <div class="w-full h-full bg-[#0b0f19] rounded-[7px] flex items-center justify-center">
              <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" role="img">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              </svg>
            </div>
          </div>
          <span class="text-base font-bold text-white tracking-tight">{t.nav.brand}</span>
        </div>
        <p class="text-xs leading-relaxed text-slate-400">
          {locale === 'es'
            ? 'La plataforma más rápida y confiable para encontrar códigos de Roblox activos. Verificados diariamente por jugadores reales.'
            : 'The fastest, most reliable hub for active Roblox codes. Tested and verified daily by passionate players.'}
        </p>
        <div class="flex items-center gap-2 text-xs text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 rounded-lg w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>{locale === 'es' ? 'Sistemas en línea y actualizados' : 'Systems online & verified today'}</span>
        </div>

        <!-- Official Channels (YouTube & TikTok) -->
        <div class="pt-3 space-y-2">
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">
            {locale === 'es' ? 'Canales Oficiales' : 'Official Channels'}
          </span>
          <div class="flex flex-col gap-2">
            <a 
              href={socialConfig.youtube.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 text-slate-200 hover:text-white transition-all group"
            >
              <svg class="w-4 h-4 text-red-500 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-white group-hover:text-red-400 transition-colors">YouTube</span>
                <span class="text-[10px] text-slate-400">{locale === 'es' ? 'Vídeos & Códigos Diarios' : 'Daily Videos & Codes'}</span>
              </div>
            </a>

            <a 
              href={socialConfig.tiktok.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/20 text-slate-200 hover:text-white transition-all group"
            >
              <svg class="w-4 h-4 text-cyan-400 group-hover:scale-110 transition-transform shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
              <div class="flex flex-col">
                <span class="text-xs font-bold text-white group-hover:text-cyan-300 transition-colors">TikTok</span>
                <span class="text-[10px] text-slate-400">{locale === 'es' ? 'Shorts & Secretos' : 'Shorts & Tips'}</span>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Top Games Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {locale === 'es' ? 'Juegos Principales' : 'Top Games'}
        </h3>
        <ul class="space-y-2 text-xs">
          {gamesData.slice(0, 5).map((game) => (
            <li>
              <a 
                href={`/${locale}/juego/${game.slug}/`} 
                class="hover:text-indigo-400 transition-colors flex items-center gap-1.5"
              >
                <span>{game.emoji}</span>
                <span>{game.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories & Features -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {locale === 'es' ? 'Categorías Populares' : 'Popular Categories'}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Anime & Shonen' : 'Anime & Shonen'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Dodgeball & Acción' : 'Dodgeball & Action'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Moda & Pasarela' : 'Fashion & Runway'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'calculadora-tradeos-blox-fruits/' : 'blox-fruits-trade-calculator/'}`} class="hover:text-amber-400 transition-colors font-semibold text-amber-300">
              {locale === 'es' ? '⚖️ Calculadora de Tradeos (Blox Fruits)' : '⚖️ Blox Fruits Trade Calculator'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'musica/' : 'music/'}`} class="hover:text-indigo-400 transition-colors font-semibold text-indigo-300">
              {locale === 'es' ? '🎵 Códigos de Música (Boombox)' : '🎵 Music Codes (Boombox IDs)'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'objetos-gratis/' : 'free-items/'}`} class="hover:text-emerald-400 transition-colors font-semibold text-emerald-300">
              {locale === 'es' ? '🎁 Ropa & Objetos Gratis (0 Robux)' : '🎁 Free Clothes & Items (0 Robux)'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'generador-nombres-roblox/' : 'roblox-username-generator/'}`} class="hover:text-purple-400 transition-colors font-semibold text-purple-300">
              {locale === 'es' ? '🎲 Generador de Nombres & Clanes' : '🎲 Username & Clan Generator'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'errores-roblox/' : 'roblox-error-codes/'}`} class="hover:text-rose-400 transition-colors font-semibold text-rose-300">
              {locale === 'es' ? '🔧 Códigos de Error & Soluciones' : '🔧 Error Codes & Fixes'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'codigos-ropa-brookhaven/' : 'brookhaven-outfit-codes/'}`} class="hover:text-pink-400 transition-colors font-semibold text-pink-300">
              {locale === 'es' ? '👗 Códigos de Ropa Brookhaven RP' : '👗 Brookhaven Outfit Codes'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'quiz-frutas-blox-fruits/' : 'blox-fruits-quiz/'}`} class="hover:text-amber-400 transition-colors font-semibold text-amber-300">
              {locale === 'es' ? '🧠 Quiz: ¿Qué Fruta eres en Blox Fruits?' : '🧠 Quiz: What Blox Fruit Are You?'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'optimizar-roblox-fps-lag/' : 'roblox-fps-unlocker-lag-fix/'}`} class="hover:text-cyan-400 transition-colors font-semibold text-cyan-300">
              {locale === 'es' ? '⚡ Desbloquear FPS & Quitar Lag' : '⚡ FPS Unlocker & Lag Fix'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'alertas-codigos-roblox/' : 'roblox-code-alerts/'}`} class="hover:text-amber-400 transition-colors font-semibold text-amber-300">
              {locale === 'es' ? '🔔 Alertas de Códigos VIP' : '🔔 VIP Code Drop Alerts'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/juego/roblox-promo-codes/`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Promo Codes Globales' : 'Global Promo Codes'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Disclaimer & Legal -->
      <div class="space-y-3 text-xs">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {t.footer.legal}
        </h3>
        <ul class="space-y-1.5 text-xs text-slate-300">
          <li>
            <a href={locale === 'es' ? '/es/aviso-legal/' : '/en/legal-notice/'} class="hover:text-indigo-400 transition-colors font-medium text-slate-200">
              {t.footer.legalNotice}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/sobre-nosotros/' : '/en/about/'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Sobre Nosotros & Estándares Editoriales' : 'About Us & Editorial Standards'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/privacidad/' : '/en/privacy/'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/politica-de-cookies/' : '/en/cookie-policy/'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Política de Cookies & Preferencias' : 'Cookie Policy & Preferences'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/terminos/' : '/en/terms/'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Términos de Servicio' : 'Terms of Service'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/contacto/' : '/en/contact/'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Contacto y Reporte de Códigos' : 'Contact & Report Broken Codes'}
            </a>
          </li>
        </ul>
        <p class="text-[11px] leading-relaxed text-slate-400 pt-2 border-t border-white/5">
          {t.footer.disclaimer}
        </p>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {currentYear} {t.nav.brand}. {t.footer.allRights}</p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <a href={locale === 'es' ? '/es/aviso-legal/' : '/en/legal-notice/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.legalNotice}</a>
        <a href={locale === 'es' ? '/es/privacidad/' : '/en/privacy/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.privacy}</a>
        <a href={locale === 'es' ? '/es/politica-de-cookies/' : '/en/cookie-policy/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.cookies}</a>
        <a href={locale === 'es' ? '/es/terminos/' : '/en/terms/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.terms}</a>
        <a href={locale === 'es' ? '/es/sobre-nosotros/' : '/en/about/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.about}</a>
        <a href={locale === 'es' ? '/es/contacto/' : '/en/contact/'} class="text-slate-400 hover:text-white transition-colors">{t.nav.contact}</a>
        <a href="#top" class="text-slate-400 hover:text-indigo-400 transition-colors flex items-center gap-1">
          <span>↑</span>
          <span>{locale === 'es' ? 'Subir' : 'Back to top'}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
