---
import type { SupportedLocale } from '../i18n/translations';
import { getTranslations } from '../i18n/translations';
import { gamesData } from '../data/games';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const currentYear = 2026;
---

<footer class="bg-[#05080e] border-t border-white/10 pt-16 pb-12 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Mission -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-indigo-500 to-cyan-400 p-[1px]">
            <div class="w-full h-full bg-[#0b0f19] rounded-[7px] flex items-center justify-center">
              <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              </svg>
            </div>
          </div>
          <span class="text-base font-bold text-white tracking-tight">{t.nav.brand}</span>
        </div>
        <p class="text-xs leading-relaxed text-slate-400">
          {locale === 'es'
            ? 'La plataforma más rápida y confiable para encontrar códigos de Roblox activos. Verificados diariamente por jugadores reales.'
            : 'The fastest, most reliable hub for active Roblox codes. Tested and verified daily by passionate players.'}
        </p>
        <div class="flex items-center gap-2 text-xs text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1.5 rounded-lg w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>{locale === 'es' ? 'Sistemas en línea y actualizados' : 'Systems online & verified today'}</span>
        </div>
      </div>

      <!-- Top Games Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {locale === 'es' ? 'Juegos Principales' : 'Top Games'}
        </h3>
        <ul class="space-y-2 text-xs">
          {gamesData.slice(0, 5).map((game) => (
            <li>
              <a 
                href={`/${locale}/juego/${game.slug}`} 
                class="hover:text-indigo-400 transition-colors flex items-center gap-1.5"
              >
                <span>{game.emoji}</span>
                <span>{game.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories & Features -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {locale === 'es' ? 'Categorías Populares' : 'Popular Categories'}
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Anime & Shonen' : 'Anime & Shonen'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Dodgeball & Acción' : 'Dodgeball & Action'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/#juegos`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Moda & Pasarela' : 'Fashion & Runway'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/${locale === 'es' ? 'musica/' : 'music/'}`} class="hover:text-indigo-400 transition-colors font-semibold text-indigo-300">
              {locale === 'es' ? '🎵 Códigos de Música (Boombox)' : '🎵 Music Codes (Boombox IDs)'}
            </a>
          </li>
          <li>
            <a href={`/${locale}/juego/roblox-promo-codes`} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Accesorios de Avatar Gratis' : 'Free Avatar Accessories'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Disclaimer & Legal -->
      <div class="space-y-3 text-xs">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {t.footer.legal}
        </h3>
        <ul class="space-y-1.5 text-xs text-slate-300">
          <li>
            <a href={locale === 'es' ? '/es/sobre-nosotros' : '/en/about'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Sobre Nosotros & Estándares Editoriales' : 'About Us & Editorial Standards'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/privacidad' : '/en/privacy'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Política de Privacidad (AdSense & Cookies)' : 'Privacy Policy (AdSense & Cookies)'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/terminos' : '/en/terms'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Términos de Servicio' : 'Terms of Service'}
            </a>
          </li>
          <li>
            <a href={locale === 'es' ? '/es/contacto' : '/en/contact'} class="hover:text-indigo-400 transition-colors">
              {locale === 'es' ? 'Contacto y Reporte de Códigos' : 'Contact & Report Broken Codes'}
            </a>
          </li>
        </ul>
        <p class="text-[11px] leading-relaxed text-slate-500 pt-2 border-t border-white/5">
          {t.footer.disclaimer}
        </p>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} {t.nav.brand}. {t.footer.allRights}</p>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <a href={locale === 'es' ? '/es/privacidad' : '/en/privacy'} class="hover:text-slate-300 transition-colors">{t.nav.privacy}</a>
        <a href={locale === 'es' ? '/es/terminos' : '/en/terms'} class="hover:text-slate-300 transition-colors">{t.nav.terms}</a>
        <a href={locale === 'es' ? '/es/sobre-nosotros' : '/en/about'} class="hover:text-slate-300 transition-colors">{t.nav.about}</a>
        <a href={locale === 'es' ? '/es/contacto' : '/en/contact'} class="hover:text-slate-300 transition-colors">{t.nav.contact}</a>
        <a href="#top" class="hover:text-indigo-400 transition-colors flex items-center gap-1">
          <span>↑</span>
          <span>{locale === 'es' ? 'Subir' : 'Back to top'}</span>
        </a>
      </div>
    </div>
  </div>
</footer>
