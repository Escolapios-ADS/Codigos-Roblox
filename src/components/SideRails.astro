---
import type { SupportedLocale } from '../i18n/translations';

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
---

<!-- Left Skyscraper Side Rail Ad (Sticky Desktop Gutters) -->
<aside 
  class="hidden min-[1600px]:flex fixed left-3 2xl:left-6 top-24 z-30 w-[140px] 2xl:w-[160px] flex-col items-center gap-3 pointer-events-auto select-none"
  aria-label={locale === 'es' ? 'Anuncios laterales izquierda' : 'Left sidebar advertisements'}
>
  <div class="text-[9px] uppercase font-mono tracking-widest text-slate-400">
    {locale === 'es' ? 'Publicidad' : 'Advertisement'}
  </div>
  
  <!-- Skyscraper 1 (160x600) -->
  <div class="w-full h-[600px] bg-[#0b101d]/85 backdrop-blur-sm border border-dashed border-white/10 hover:border-indigo-500/30 rounded-2xl flex flex-col items-center justify-between p-3 text-center transition-all shadow-xl">
    <div class="w-full text-center py-2 border-b border-white/5">
      <span class="text-[10px] font-mono font-semibold text-indigo-400">SKYSCRAPER 160x600</span>
    </div>
    
    <div class="space-y-2 my-auto">
      <div class="w-10 h-10 mx-auto rounded-xl bg-white/5 flex items-center justify-center text-lg">
        📢
      </div>
      <p class="text-[11px] font-medium text-slate-300">
        {locale === 'es' ? 'Espacio Lateral Izquierdo' : 'Left Side Rail Ad'}
      </p>
      <p class="text-[10px] text-slate-400 leading-tight">
        Google AdSense / High RPM
      </p>
    </div>

    <div class="w-full text-center py-1.5 bg-white/[0.02] rounded-lg">
      <span class="text-[9px] text-slate-400 font-mono">Slot: lateral-izq-1</span>
    </div>
  </div>
</aside>

<!-- Right Skyscraper Side Rail Ad (Sticky Desktop Gutters) -->
<aside 
  class="hidden min-[1600px]:flex fixed right-3 2xl:right-6 top-24 z-30 w-[140px] 2xl:w-[160px] flex-col items-center gap-3 pointer-events-auto select-none"
  aria-label={locale === 'es' ? 'Anuncios laterales derecha' : 'Right sidebar advertisements'}
>
  <div class="text-[9px] uppercase font-mono tracking-widest text-slate-400">
    {locale === 'es' ? 'Publicidad' : 'Advertisement'}
  </div>
  
  <!-- Skyscraper 2 (160x600) -->
  <div class="w-full h-[600px] bg-[#0b101d]/85 backdrop-blur-sm border border-dashed border-white/10 hover:border-indigo-500/30 rounded-2xl flex flex-col items-center justify-between p-3 text-center transition-all shadow-xl">
    <div class="w-full text-center py-2 border-b border-white/5">
      <span class="text-[10px] font-mono font-semibold text-indigo-400">SKYSCRAPER 160x600</span>
    </div>
    
    <div class="space-y-2 my-auto">
      <div class="w-10 h-10 mx-auto rounded-xl bg-white/5 flex items-center justify-center text-lg">
        🎯
      </div>
      <p class="text-[11px] font-medium text-slate-300">
        {locale === 'es' ? 'Espacio Lateral Derecho' : 'Right Side Rail Ad'}
      </p>
      <p class="text-[10px] text-slate-400 leading-tight">
        Google AdSense / High RPM
      </p>
    </div>

    <div class="w-full text-center py-1.5 bg-white/[0.02] rounded-lg">
      <span class="text-[9px] text-slate-400 font-mono">Slot: lateral-der-1</span>
    </div>
  </div>
</aside>
