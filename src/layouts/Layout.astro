---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SideRails from '../components/SideRails.astro';
import type { SupportedLocale } from '../i18n/translations';
import { getSeoUrls } from '../utils/seo';
import { buildUnifiedGraph } from '../utils/structuredData';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: SupportedLocale;
  currentSlug?: string;
  ogType?: 'website' | 'article';
  schema?: Record<string, any>;
  pageType?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  locale,
  currentSlug,
  ogType = 'website',
  schema,
  pageType,
  noIndex = false,
} = Astro.props;

// Compute accurate canonical and hreflang URLs across all 81 routes
const { canonicalUrl, esUrl, enUrl } = getSeoUrls(Astro.url.pathname, locale, currentSlug);

// Generate unified Schema.org JSON-LD Knowledge Graph
const unifiedSchema = buildUnifiedGraph({
  canonicalUrl,
  title,
  description,
  locale,
  pageType,
  customSchema: schema,
});

// Google Analytics 4 Measurement ID
const GA_MEASUREMENT_ID = import.meta.env.PUBLIC_GA_ID || 'G-YSBE19CC5T';
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicon Suite (SVG, PNG Multi-res, Apple Touch & Multi-res ICO) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Web App Manifest (PWA & Android Home Screen) -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#080C14" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CódigosRoblox" />
    <meta name="generator" content={Astro.generator} />

    <!-- Performance & Speed Optimization: Resource Hints -->
    <meta http-equiv="x-dns-prefetch-control" content="on" />
    <link rel="dns-prefetch" href="https://tr.rbxcdn.com" />
    <link rel="dns-prefetch" href="https://thumbnails.roblox.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://tr.rbxcdn.com" crossorigin />

    <!-- Automatic HTTPS Enforcement & Mixed Content Shield -->
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <script is:inline>
      if (typeof window !== 'undefined' && location.protocol === 'http:' && !['localhost', '127.0.0.1'].includes(location.hostname)) {
        location.replace('https:' + window.location.href.substring(window.location.protocol.length));
      }
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, follow" : "index, follow"} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}

    <!-- Multilingual Hreflang SEO Tags -->
    {!noIndex && (
      <>
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>
    )}

    <!-- Web Syndication Feeds (Google Publisher Center, Google Discover & Feed Readers) -->
    <link rel="alternate" type="application/rss+xml" title={locale === 'es' ? 'Códigos Roblox (Feed Global)' : 'Roblox Codes (Global Feed)'} href="https://codigosroblox.org/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={locale === 'es' ? 'Códigos Roblox en Español' : 'Roblox Codes in Spanish'} href="https://codigosroblox.org/es/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={locale === 'es' ? 'Roblox Codes en Inglés' : 'Roblox Codes in English'} href="https://codigosroblox.org/en/rss.xml" />

    <!-- Google Search Console & Webmaster Verification Hook -->
    <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "google-site-verification-token"} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content={locale === 'es' ? 'Códigos Roblox 2026' : 'Roblox Codes 2026'} />
    <meta property="og:image" content="https://codigosroblox.org/og-image.png" />
    <meta property="og:image:secure_url" content="https://codigosroblox.org/og-image.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    {!noIndex && <meta property="twitter:url" content={canonicalUrl} />}
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://codigosroblox.org/og-image.png" />
    <meta property="twitter:image:alt" content={title} />

    <!-- Structured Data JSON-LD (Schema.org Knowledge Graph) -->
    {!noIndex && <script type="application/ld+json" set:html={JSON.stringify(unifiedSchema)} />}

    <!-- Google Consent Mode v2 Default (TCF & ePrivacy Compliant) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      try {
        const storedConsent = localStorage.getItem('roblox_cookie_consent');
        let adsAllowed = false;
        let analyticsAllowed = false;

        if (storedConsent) {
          try {
            const parsed = JSON.parse(storedConsent);
            adsAllowed = parsed.advertising === true;
            analyticsAllowed = parsed.analytics === true;
          } catch (err) {
            adsAllowed = storedConsent === 'accepted';
            analyticsAllowed = storedConsent === 'accepted';
          }
        }

        gtag('consent', 'default', {
          'ad_storage': adsAllowed ? 'granted' : 'denied',
          'ad_user_data': adsAllowed ? 'granted' : 'denied',
          'ad_personalization': adsAllowed ? 'granted' : 'denied',
          'analytics_storage': analyticsAllowed ? 'granted' : 'denied'
        });
      } catch (e) {
        gtag('consent', 'default', {
          'ad_storage': 'denied',
          'ad_user_data': 'denied',
          'ad_personalization': 'denied',
          'analytics_storage': 'denied'
        });
      }
    </script>

    <!-- Google Analytics 4 (GA4) with Google Consent Mode v2 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID, {
        anonymize_ip: true,
        cookie_flags: 'SameSite=None;Secure'
      });

      // Global Safe Analytics Event Dispatcher
      window.trackAnalyticsEvent = function(eventName, params) {
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, params || {});
          }
        } catch (err) {
          console.warn('Analytics event dispatch warning:', err);
        }
      };
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[#080c14] text-slate-100 antialiased selection:bg-indigo-600 selection:text-white">
    <div id="top"></div>

    <Header locale={locale} currentSlug={currentSlug} />

    <!-- Left & Right Skyscraper Side Rail Ads for Desktop Gutters -->
    <SideRails locale={locale} />

    <main class="flex-grow relative z-10">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- GDPR & AdSense EU User Consent Banner -->
    <CookieBanner locale={locale} />

    <!-- Global Toast Notification Container for One-Click Copy -->
    <div 
      id="copy-toast" 
      class="fixed bottom-6 right-4 sm:right-6 left-4 sm:left-auto max-w-sm z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-3 bg-slate-900/95 backdrop-blur-md border border-emerald-500/50 shadow-2xl shadow-emerald-500/20 px-4 py-3 rounded-xl text-sm font-semibold text-white"
    >
      <div class="w-6 h-6 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-white text-xs font-bold" id="toast-title">
          {locale === 'es' ? '¡Código copiado!' : 'Code copied!'}
        </span>
        <span class="text-slate-400 text-[11px]" id="toast-body">
          {locale === 'es' ? 'Listo para pegar en Roblox' : 'Ready to paste into Roblox'}
        </span>
      </div>
    </div>

    <!-- Global Script for 1-Click Copy with Sound Feedback & Toast -->
    <script is:inline>
      let _globalAudioCtx = null;
      function playChirpSound() {
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          if (!_globalAudioCtx || _globalAudioCtx.state === 'closed') {
            _globalAudioCtx = new AudioContextClass();
          } else if (_globalAudioCtx.state === 'suspended') {
            _globalAudioCtx.resume();
          }
          const ctx = _globalAudioCtx;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(587.33, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.06, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.1);
        } catch(e) {}
      }

      window.copyCodeToClipboard = async function(code, buttonElement) {
        try {
          const isSpanish = document.documentElement.lang === 'es';
          await navigator.clipboard.writeText(code);
          playChirpSound();

          // Google Analytics 4 Custom Event: Copy Code
          if (typeof window.trackAnalyticsEvent === 'function') {
            window.trackAnalyticsEvent('copy_code', {
              code_text: code,
              page_location: window.location.pathname,
              locale: isSpanish ? 'es' : 'en'
            });
          }
          
          // Toast trigger
          const toast = document.getElementById('copy-toast');
          const toastBody = document.getElementById('toast-body');
          if (toast && toastBody) {
            toastBody.textContent = `"${code}"`;
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            
            clearTimeout(window.__toastTimeout);
            window.__toastTimeout = setTimeout(() => {
              toast.classList.add('translate-y-24', 'opacity-0');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }

          // Visual feedback on button if passed
          if (buttonElement) {
            const originalContent = buttonElement.innerHTML;
            buttonElement.classList.add('bg-emerald-600', 'text-white', 'border-emerald-400');
            buttonElement.classList.remove('bg-indigo-600', 'bg-white/10');
            buttonElement.innerHTML = `
              <svg class="w-4 h-4 text-white inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>${isSpanish ? '¡Copiado!' : 'Copied!'}</span>
            `;
            setTimeout(() => {
              buttonElement.innerHTML = originalContent;
              buttonElement.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-400');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      };

      window.copyAllCodes = async function(codesList, buttonElement) {
        try {
          const isSpanish = document.documentElement.lang === 'es';
          const text = codesList.join('\n');
          await navigator.clipboard.writeText(text);
          playChirpSound();

          // Google Analytics 4 Custom Event: Copy All Codes
          if (typeof window.trackAnalyticsEvent === 'function') {
            window.trackAnalyticsEvent('copy_all_codes', {
              codes_count: codesList.length,
              page_location: window.location.pathname,
              locale: isSpanish ? 'es' : 'en'
            });
          }

          const toast = document.getElementById('copy-toast');
          const toastTitle = document.getElementById('toast-title');
          const toastBody = document.getElementById('toast-body');
          
          if (toast && toastTitle && toastBody) {
            toastTitle.textContent = isSpanish ? '¡Todos los códigos copiados!' : 'All codes copied!';
            toastBody.textContent = isSpanish ? `${codesList.length} códigos listos en el portapapeles` : `${codesList.length} codes ready in clipboard`;
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            
            clearTimeout(window.__toastTimeout);
            window.__toastTimeout = setTimeout(() => {
              toast.classList.add('translate-y-24', 'opacity-0');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }

          if (buttonElement) {
            const originalContent = buttonElement.innerHTML;
            buttonElement.classList.add('bg-emerald-600', 'border-emerald-400', 'text-white');
            buttonElement.innerHTML = `✓ ${isSpanish ? '¡Todos Copiados!' : 'All Copied!'}`;
            setTimeout(() => {
              buttonElement.innerHTML = originalContent;
              buttonElement.classList.remove('bg-emerald-600', 'border-emerald-400', 'text-white');
            }, 2200);
          }
        } catch(e) {
          console.error('Failed to copy all: ', e);
        }
      };

      window.sharePage = async function(title, url, buttonElement) {
        const isSpanish = document.documentElement.lang === 'es';

        // Google Analytics 4 Custom Event: Share Page
        if (typeof window.trackAnalyticsEvent === 'function') {
          window.trackAnalyticsEvent('share', {
            method: navigator.share ? 'native_share' : 'clipboard',
            content_type: 'page',
            item_id: url
          });
        }

        if (navigator.share) {
          try {
            await navigator.share({ title, url });
          } catch(e) {}
        } else {
          try {
            await navigator.clipboard.writeText(url);
            playChirpSound();
            if (buttonElement) {
              const orig = buttonElement.innerHTML;
              buttonElement.textContent = isSpanish ? '¡Enlace copiado!' : 'Link copied!';
              setTimeout(() => { buttonElement.innerHTML = orig; }, 2000);
            }
          } catch(e) {}
        }
      };

      // Alias copyCode
      window.copyCode = window.copyCodeToClipboard;

      // Community Voting on Active Codes
      window.voteCode = function(code, type, buttonElement) {
        const isSpanish = document.documentElement.lang === 'es';
        const storageKey = 'roblox_vote_' + code;
        const existingVote = localStorage.getItem(storageKey);
        const widget = buttonElement.closest('.community-vote-widget');
        if (!widget) return;

        const upCountEl = widget.querySelector('.up-count');
        const downCountEl = widget.querySelector('.down-count');
        const pctEl = widget.querySelector('.verified-pct');
        const upBtn = widget.querySelector('.vote-up-btn');
        const downBtn = widget.querySelector('.vote-down-btn');

        let up = parseInt(upCountEl ? upCountEl.textContent : '0', 10) || 0;
        let down = parseInt(downCountEl ? downCountEl.textContent : '0', 10) || 0;

        const toast = document.getElementById('copy-toast');
        const toastTitle = document.getElementById('toast-title');
        const toastBody = document.getElementById('toast-body');

        function showToast(title, body) {
          if (toast && toastTitle && toastBody) {
            toastTitle.textContent = title;
            toastBody.textContent = body;
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            clearTimeout(window.__toastTimeout);
            window.__toastTimeout = setTimeout(() => {
              toast.classList.add('translate-y-24', 'opacity-0');
              toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2500);
          }
        }

        // Anti-spam velocity throttle: maximum 4 votes per 5 seconds
        window.__recentVotes = (window.__recentVotes || []).filter(t => Date.now() - t < 5000);
        if (window.__recentVotes.length >= 4) {
          showToast(
            isSpanish ? '⏳ Votación acelerada' : '⏳ Slow down',
            isSpanish ? 'Espera unos segundos antes de enviar otro voto o reporte.' : 'Please wait a moment before casting another vote.'
          );
          return;
        }
        window.__recentVotes.push(Date.now());

        if (existingVote) {
          showToast(
            isSpanish ? '¡Ya has votado!' : 'Already voted!',
            isSpanish ? 'Tu opinión sobre este código ya fue registrada.' : 'Your feedback on this code is already recorded.'
          );
          return;
        }

        playChirpSound();
        localStorage.setItem(storageKey, type);

        // Google Analytics 4 Custom Event: Vote Code
        if (typeof window.trackAnalyticsEvent === 'function') {
          window.trackAnalyticsEvent('vote_code', {
            code_text: code,
            vote_type: type,
            page_location: window.location.pathname,
            locale: isSpanish ? 'es' : 'en'
          });
        }

        if (type === 'up') {
          up += 1;
          if (upCountEl) upCountEl.textContent = String(up);
          if (upBtn) upBtn.classList.add('text-emerald-400', 'font-black');
          showToast(
            isSpanish ? '✓ ¡Gracias por tu voto!' : '✓ Thanks for voting!',
            isSpanish ? 'Confirmas que este código sigue funcionando hoy.' : 'You confirmed this code is working today.'
          );
        } else {
          down += 1;
          if (downCountEl) downCountEl.textContent = String(down);
          if (downBtn) downBtn.classList.add('text-rose-400', 'font-black');
          showToast(
            isSpanish ? '⚠️ Reporte registrado' : '⚠️ Report received',
            isSpanish ? 'Nuestro equipo editorial revisará este código.' : 'Our editorial team will test this code.'
          );
        }

        const total = up + down;
        const newPct = total > 0 ? Math.round((up / total) * 100) : 100;
        if (pctEl) {
          pctEl.textContent = newPct + '%';
          if (newPct < 90) {
            pctEl.className = 'verified-pct text-[10px] px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-300 border border-amber-500/30 font-bold';
          }
        }
      };

      // Restore user votes on DOM load
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.community-vote-widget').forEach((widget) => {
          const code = widget.getAttribute('data-code');
          if (!code) return;
          const vote = localStorage.getItem('roblox_vote_' + code);
          if (vote === 'up') {
            const btn = widget.querySelector('.vote-up-btn');
            if (btn) btn.classList.add('text-emerald-400', 'font-black');
          } else if (vote === 'down') {
            const btn = widget.querySelector('.vote-down-btn');
            if (btn) btn.classList.add('text-rose-400', 'font-black');
          }
        });
      });
    </script>
  </body>
</html>
