# ==============================================================================
# CodigosRoblox.org - Environment Variables Example
# Copy this file to .env or configure in your deployment platform (Vercel / Cloudflare / Netlify)
# ==============================================================================

# Google Analytics 4 Measurement ID
# In production, replace with your live GA4 Property ID (e.g., G-A1B2C3D4E5)
# In development, leave blank or as placeholder to run in passive mode without tracking
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console Verification Token
# Optional meta tag verification token for Google Search Console
PUBLIC_GOOGLE_SITE_VERIFICATION=google-site-verification-token
